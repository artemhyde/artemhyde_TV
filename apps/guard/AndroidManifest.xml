<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.glasstv.guard"
    android:versionCode="5"
    android:versionName="1.3.1">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Право для команд между своими приложениями HYDE (06.11): только с тем же ключом подписи. Объявлено в каждом из них,
         чтобы порядок установки не мешал -->
    <permission android:name="app.glasstv.permission.HYDE" android:protectionLevel="signature" />
    <!-- Записку на экране «Дома» показывает сам «Дом» (10.11): его приёмник берёт её только от приложений HYDE -->
    <uses-permission android:name="app.glasstv.permission.HYDE" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Время последнего нажатия и замки экрана для таймера простоя: выдаётся с ПК, pm grant app.glasstv.guard android.permission.DUMP -->
    <uses-permission android:name="android.permission.DUMP" />
    <!-- Присмотр за локальной службой: список процессов и верхнее окно в dumpsys activity система отдаёт только с этим правом.
         Выдаётся с ПК: appops set app.glasstv.guard GET_USAGE_STATS allow -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Выдаётся один раз с ПК: pm grant app.glasstv.guard android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Ночная подсветка. Выдаётся с ПК: appops set app.glasstv.guard WRITE_SETTINGS allow -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Умный звук: эффект на общий микшер (сессия 0). Обычное право, выдаётся при установке, pm grant не нужен -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Обновления приложений не из магазина (Updates.java). Ставить приложения: с ПК appops set app.glasstv.guard REQUEST_INSTALL_PACKAGES allow.
         Два других права обычные, выдаются при установке: обновлять без нажатий (если установщик «Сторож») и видеть все приложения -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Чтобы видеть Key Mapper -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="io.github.sds100.keymapper" />
        <!-- ByeByeDPI (модуль для России): присмотр за туннелем и выключатель автора ToggleActivity (Bye.java) -->
        <package android:name="io.github.romanvht.byedpi" />
        <!-- Присмотр за локальной службой: открыть приложение, чей сервер молчит, и вернуть прежний экран -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- Скрытая служба Dolby в прошивке: чтобы Сторож её видел (Android 11+) -->
        <package android:name="com.dolby.android.audio.service" />
    </queries>

    <application
        android:label="Сторож"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Guard">

        <!-- Библиотека прошивки TCL: настоящая подсветка панели (TvBacklightManager). Нет её: работаем без неё -->
        <uses-library android:name="com.tcl.tv.display" android:required="false" />

        <!-- Экран состояния: что Сторож держит в порядке -->
        <activity
            android:name=".GuardActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Вопрос «Отправлять автору технические отчёты?» (Ask.java): один раз после обновления, поверх главного экрана -->
        <activity
            android:name=".Ask"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@style/GuardAsk" />

        <!-- Работает фоном всё время: отладка по сети, Key Mapper, записки с телефона -->
        <!-- Пустой слушатель уведомлений: по нему система отдаёт список медиасессий (идёт ли видео, когда экран гаснет) -->
        <service
            android:name=".Listen"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Домашний сторож телевизора: держит отладку и службы пульта, принимает записки из домашней сети" />
        </service>

        <receiver android:name=".Boot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Команды с ПК (adb shell am broadcast -n app.glasstv.guard/.Cmd ...). Только у кого право DUMP: у adb оно есть,
             у обычного приложения нет (06.11, план Codex, блок 4: раньше любое приложение могло, например, включить отладку по сети) -->
        <receiver android:name=".Cmd" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- Те же команды от своих приложений («Дом», «Ночной режим», «Звук», «Картинка»): только с тем же ключом подписи -->
        <receiver android:name=".AppCmd" android:exported="true" android:permission="app.glasstv.permission.HYDE" />
        <!-- Итог установки обновления от системы (Updates.java) -->
        <receiver android:name=".UpdDone" android:exported="false" />
    </application>
</manifest>
