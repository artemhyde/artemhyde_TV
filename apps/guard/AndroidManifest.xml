<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.glasstv.guard"
    android:versionCode="5"
    android:versionName="1.3.1">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Время последнего нажатия и замки экрана для таймера простоя: выдаётся с ПК, pm grant app.glasstv.guard android.permission.DUMP -->
    <uses-permission android:name="android.permission.DUMP" />
    <!-- Присмотр за локальной службой: список процессов и верхнее окно в dumpsys activity система отдаёт только с этим правом.
         Выдаётся с ПК: appops set app.glasstv.guard GET_USAGE_STATS allow -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Выдаётся один раз с ПК: pm grant app.glasstv.guard android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Ночная подсветка. Выдаётся с ПК: appops set app.glasstv.guard WRITE_SETTINGS allow -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Умный звук: эффект на общий микшер (сессия 0). Обычное право, выдаётся при установке, pm grant не нужен -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Чтобы видеть Key Mapper -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="io.github.sds100.keymapper" />
        <!-- Присмотр за локальной службой: открыть приложение, чей сервер молчит, и вернуть прежний экран -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- Скрытая служба Dolby в прошивке: чтобы Сторож её видел (Android 11+) -->
        <package android:name="com.dolby.android.audio.service" />
    </queries>

    <application
        android:label="Сторож"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Guard">

        <!-- Библиотека прошивки TCL: настоящая подсветка панели (TvBacklightManager). Нет её: работаем без неё -->
        <uses-library android:name="com.tcl.tv.display" android:required="false" />

        <!-- Экран состояния: что Сторож держит в порядке -->
        <activity
            android:name=".GuardActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Работает фоном всё время: отладка по сети, Key Mapper, записки с телефона -->
        <!-- Пустой слушатель уведомлений: по нему система отдаёт список медиасессий (идёт ли видео, когда экран гаснет) -->
        <service
            android:name=".Listen"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Домашний сторож телевизора: держит отладку и службы пульта, принимает записки из домашней сети" />
        </service>

        <receiver android:name=".Boot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Команды с ПК для проверки (подсветка TCL) -->
        <receiver android:name=".Cmd" android:exported="true" />
    </application>
</manifest>
