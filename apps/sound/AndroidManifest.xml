<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.glasstv.sound"
    android:versionCode="3"
    android:versionName="1.2.0">

    <!-- Команды между своими приложениями HYDE (06.11): входы AppCmd «Сторожа» и «Волны» и приёмник Now «Дома» пускают только
         приложения с тем же ключом подписи -->
    <permission android:name="app.glasstv.permission.HYDE" android:protectionLevel="signature" />
    <uses-permission android:name="app.glasstv.permission.HYDE" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Права не нужны: эффекты держит «Сторож», мы только шлём ему команды (Android 11+: чужое приложение видно через queries) -->
    <queries>
        <package android:name="app.glasstv.guard" />
        <!-- Вкладка «Картинка» в шапке открывает соседнюю полосу -->
        <package android:name="app.glasstv.picture" />
    </queries>

    <application
        android:label="Звук"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@style/Sound">

        <!-- Панель поверх текущего приложения: прозрачная тема, фильм за ней продолжает идти -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
