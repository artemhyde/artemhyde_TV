<?xml version="1.0" encoding="utf-8"?>
<!-- Круглый значок: тёмный фон и полумесяц -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="96dp" android:height="96dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#FF0B0E1A"
                android:endColor="#FF2A1F3D" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center"
        android:drawable="@drawable/moon" />
</layer-list>
