diff --git a/app/src/main/kotlin/com/auramusic/app/playback/VolnaBridge.kt b/app/src/main/kotlin/com/auramusic/app/playback/VolnaBridge.kt
new file mode 100644
index 00000000..b7402032
--- /dev/null
+++ b/app/src/main/kotlin/com/auramusic/app/playback/VolnaBridge.kt
@@ -0,0 +1,120 @@
+/**
+ * Auramusic Project (C) 2026
+ * Licensed under GPL-3.0 | See git history for contributors
+ */
+
+package com.auramusic.app.playback
+
+import android.os.Bundle
+import android.util.Log
+import com.auramusic.app.constants.MediaSessionConstants
+import com.auramusic.innertube.YouTube
+import com.auramusic.innertube.models.SongItem
+import com.auramusic.innertube.models.WatchEndpoint
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+
+const val VOLNA_PACKAGE = "app.glasstv.volna"
+
+/**
+ * Личное из аккаунта для «Волны»: профиль (канал аккаунта), подборки, лайки. Куки остаются здесь: наружу уходят только
+ * названия и id треков. Плеера этот класс не касается, поэтому его ответы не могут включить музыку.
+ * Лайк или подборка несут имя профиля: если канал не найден, команда отклоняется и в основной профиль не попадёт.
+ */
+class VolnaBridge {
+    private val lane = Mutex()
+    private var channels: List<YouTube.Channel>? = null
+
+    suspend fun handle(action: String, args: Bundle): String = withContext(Dispatchers.IO) {
+        lane.withLock {
+            val out = runCatching {
+                when (action) {
+                    MediaSessionConstants.ACTION_PROFILE -> profile(args)
+                    MediaSessionConstants.ACTION_FEED -> feed(args)
+                    MediaSessionConstants.ACTION_LIKE -> like(args)
+                    MediaSessionConstants.ACTION_WHOAMI -> whoami(args)
+                    else -> fail("BAD_COMMAND")
+                }
+            }.getOrElse {
+                Log.w("volna-aura", "$action: ${it.javaClass.simpleName} ${it.message}")
+                fail("IO")
+            }
+            out.toString()
+        }
+    }
+
+    private fun fail(why: String) = JSONObject().put("ok", false).put("err", why)
+
+    // Включить профиль. Пустое имя: основной. Вернёт причину, если его нельзя включить
+    private suspend fun use(name: String): String? {
+        if (!YouTube.isLoggedIn()) {
+            YouTube.pageId = null
+            return "NO_LOGIN"
+        }
+        if (name.isEmpty()) {
+            YouTube.pageId = null
+            return null
+        }
+        val list = channels ?: YouTube.channels().getOrNull()?.takeIf { it.isNotEmpty() }?.also { channels = it } ?: return "IO"
+        val pageId = list.firstOrNull { it.name.equals(name, ignoreCase = true) }?.pageId ?: run {
+            channels = null   // канал могли создать только что
+            return "BAD_PROFILE"
+        }
+        YouTube.pageId = pageId
+        return null
+    }
+
+    private suspend fun profile(args: Bundle): JSONObject {
+        val name = args.getString("profile").orEmpty()
+        val err = use(name)
+        Log.i("volna-aura", "профиль: «$name», ${err ?: "включён"}")
+        return if (err == null) JSONObject().put("ok", true) else fail(err)
+    }
+
+    private suspend fun whoami(args: Bundle): JSONObject {
+        use(args.getString("profile").orEmpty())?.let { return fail(it) }
+        val info = YouTube.accountInfo().getOrThrow()
+        return JSONObject().put("ok", true).put("name", info.name)
+    }
+
+    // like: 1 лайк, 0 снять оценку, -1 «не нравится»
+    private suspend fun like(args: Bundle): JSONObject {
+        use(args.getString("profile").orEmpty())?.let { return fail(it) }
+        val id = args.getString("id").orEmpty()
+        if (id.isBlank()) return fail("BAD_ID")
+        val state = args.getInt("like")
+        val done = if (state < 0) YouTube.dislikeVideo(id) else YouTube.likeVideo(id, state > 0)
+        done.getOrThrow()
+        return JSONObject().put("ok", true)
+    }
+
+    private suspend fun feed(args: Bundle): JSONObject {
+        use(args.getString("profile").orEmpty())?.let { return fail(it) }
+        val limit = args.getInt("limit", 100).coerceIn(1, 100)
+        val songs: List<SongItem> = when (args.getString("kind")) {
+            "home" -> YouTube.home().getOrThrow().sections.flatMap { it.items }.filterIsInstance<SongItem>()
+            "liked" -> YouTube.playlist("LM").getOrThrow().songs
+            "radio" -> {
+                val seed = args.getString("seed").orEmpty()
+                if (seed.isBlank()) return fail("BAD_ID")
+                YouTube.next(WatchEndpoint(videoId = seed, playlistId = "RDAMVM$seed")).getOrThrow().items
+            }
+            else -> return fail("BAD_KIND")
+        }
+        val items = JSONArray()
+        for (s in songs.distinctBy { it.id }.take(limit)) {
+            items.put(
+                JSONObject()
+                    .put("id", s.id)
+                    .put("t", s.title)
+                    .put("a", s.artists.joinToString(", ") { it.name })
+                    .put("d", s.duration ?: 0),
+            )
+        }
+        return JSONObject().put("ok", true).put("items", items)
+    }
+}
