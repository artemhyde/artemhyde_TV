+++ b/app/src/main/java/com/phlox/tvwebbrowser/ux/AddressEditorView.kt
@@ -0,0 +1,399 @@
+package com.phlox.tvwebbrowser.ux
+
+import android.content.Context
+import android.content.res.ColorStateList
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.drawable.StateListDrawable
+import android.os.SystemClock
+import android.text.InputType
+import android.util.TypedValue
+import android.view.FocusFinder
+import android.view.Gravity
+import android.view.KeyEvent
+import android.view.View
+import android.view.ViewGroup
+import android.view.animation.DecelerateInterpolator
+import android.view.inputmethod.EditorInfo
+import android.view.inputmethod.InputMethodManager
+import android.widget.EditText
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.activity.OnBackPressedCallback
+import androidx.core.view.isVisible
+import androidx.core.widget.doAfterTextChanged
+import com.phlox.tvwebbrowser.R
+
+/**
+ * The address of the page, apart from the search: a panel at the top with the whole address in up to four lines, the
+ * caret at its end and nothing selected, and two rows of buttons under it: what to do with the address, then the fine
+ * editing. The keyboard stays hidden until it is asked for, so Left and Right move the caret in the text at once; Down goes
+ * to the buttons, Up back; OK in the text shows the keyboard.
+ * Opened by Up at the top of the page, the Menu key and the address field of the bar. Back closes it (one more Back
+ * after a change, the edits are lost); the buttons that edit repeat while OK is held.
+ */
+class AddressEditorView(context: Context, private val host: Host) : FrameLayout(context) {
+    interface Host {
+        /** Opens the text as an address, or searches it */
+        fun submit(text: String)
+        /** The search bar opens in place of this panel */
+        fun openSearch()
+        /** The panel went away: the focus goes back */
+        fun onClosed()
+    }
+
+    private val panel = LinearLayout(context)
+    private val position = TextView(context)
+    private val hint = TextView(context)
+    private lateinit var openButton: View
+    private var original = ""
+    private var warned = false
+    private var keyboardUp = false
+    /** The focus is on the button that erases one character: the character is marked in the text */
+    private var markLeft = false
+
+    private val caretPaint = Paint().apply {
+        color = 0xFFFFD54A.toInt()
+    }
+    private val markPaint = Paint().apply {
+        color = 0x808FB8FF.toInt()
+    }
+
+    private val input = object : EditText(context) {
+        override fun onSelectionChanged(selStart: Int, selEnd: Int) {
+            super.onSelectionChanged(selStart, selEnd)
+            //the constructor of EditText calls it too: only what is set before the field is used here
+            position.text = context.getString(R.string.ux_addr_position, selEnd.coerceAtLeast(0), length())
+            invalidate()
+        }
+
+        override fun onKeyPreIme(keyCode: Int, event: KeyEvent): Boolean {
+            if (keyCode == KeyEvent.KEYCODE_BACK && event.action == KeyEvent.ACTION_UP && event.eventTime - event.downTime < HOLD_BACK_MS) {
+                setKeyboardUp(false)
+            }
+            return super.onKeyPreIme(keyCode, event)
+        }
+
+        //the caret of its own: the one of EditText blinks and goes away with the focus, and the buttons move it too
+        override fun onDraw(canvas: Canvas) {
+            super.onDraw(canvas)
+            val l = layout ?: return
+            val offset = selectionEnd.coerceIn(0, length())
+            val line = l.getLineForOffset(offset)
+            //between two characters, on neither of them, in a color no text has
+            val half = UxGlass.dp(context, 1.5f).toFloat()
+            val x = compoundPaddingLeft + l.getPrimaryHorizontal(offset)
+            val top = extendedPaddingTop.toFloat()
+            canvas.drawRect(x - half, top + l.getLineTop(line), x + half, top + l.getLineBottom(line), caretPaint)
+            if (markLeft && offset > 0) {
+                val left = offset - 1
+                val leftLine = l.getLineForOffset(left)
+                val from = compoundPaddingLeft + l.getPrimaryHorizontal(left)
+                val to = from + paint.measureText(text, left, offset)
+                canvas.drawRect(from, top + l.getLineTop(leftLine), to, top + l.getLineBottom(leftLine), markPaint)
+            }
+        }
+    }
+
+    /** Back closes the panel while it shows */
+    val backCallback = object : OnBackPressedCallback(false) {
+        override fun handleOnBackPressed() {
+            if (input.text.toString() != original && !warned) {
+                warned = true
+                hint.text = context.getString(R.string.ux_addr_back_again)
+                //not lost among the usual hints
+                hint.setTextColor(0xFFFFD54A.toInt())
+                return
+            }
+            close()
+        }
+    }
+
+    init {
+        visibility = GONE
+        //darker than the other panels: the text of the page right under the panel should not read as a part of it
+        setBackgroundColor(0xD9101014.toInt())
+        isFocusable = false
+        outlineProvider = null
+        elevation = UxGlass.dp(context, 7.9f).toFloat()
+
+        panel.orientation = LinearLayout.VERTICAL
+        panel.background = UxGlass.panel(context)
+        val pad = UxGlass.dp(context, 16f)
+        panel.setPadding(pad, UxGlass.dp(context, 12f), pad, UxGlass.dp(context, 12f))
+        val width = minOf(UxGlass.dp(context, PANEL_WIDTH_DP), context.resources.displayMetrics.widthPixels - 2 * UxGlass.dp(context, 24f))
+        addView(panel, LayoutParams(width, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP or Gravity.CENTER_HORIZONTAL).apply {
+            topMargin = UxGlass.dp(context, 20f)
+        })
+
+        panel.addView(buildHeader())
+        panel.addView(buildField())
+        buildButtons()
+
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+        hint.setTextColor(UxGlass.TEXT_FAINT)
+        hint.gravity = Gravity.CENTER
+        panel.addView(hint, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+            topMargin = UxGlass.dp(context, 8f)
+        })
+    }
+
+    private fun buildHeader(): View {
+        val row = LinearLayout(context)
+        row.orientation = LinearLayout.HORIZONTAL
+        val title = TextView(context)
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        title.setTextColor(UxGlass.TEXT_FAINT)
+        title.text = context.getString(R.string.ux_addr_title)
+        row.addView(title, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+        position.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        position.setTextColor(UxGlass.TEXT_HINT)
+        row.addView(position)
+        return row
+    }
+
+    private fun buildField(): View {
+        input.setTextSize(TypedValue.COMPLEX_UNIT_SP, 20f)
+        input.letterSpacing = 0.03f
+        input.setTextColor(UxGlass.TEXT)
+        input.highlightColor = 0x598FB8FF
+        val fieldRadius = UxGlass.dp(context, 12f).toFloat()
+        input.background = StateListDrawable().apply {
+            //with the keyboard up the focus is on its key: one white mark on the screen, not two
+            addState(intArrayOf(android.R.attr.state_activated), UxGlass.rounded(UxGlass.VEIL, fieldRadius))
+            addState(intArrayOf(android.R.attr.state_focused), UxGlass.rounded(UxGlass.VEIL, fieldRadius).apply {
+                setStroke(UxGlass.dp(context, 2f), 0xFFFFFFFF.toInt())
+            })
+            addState(intArrayOf(), UxGlass.rounded(UxGlass.VEIL, fieldRadius))
+        }
+        input.setPadding(UxGlass.dp(context, 14f), UxGlass.dp(context, 10f), UxGlass.dp(context, 14f), UxGlass.dp(context, 10f))
+        input.inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_URI or InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
+        input.imeOptions = EditorInfo.IME_ACTION_GO or EditorInfo.IME_FLAG_NO_EXTRACT_UI
+        input.setImeActionLabel(context.getString(R.string.ux_addr_open), EditorInfo.IME_ACTION_GO)
+        //the caret is in place already: the keyboard starts on its letters
+        input.privateImeOptions = "app.glasstv.keyboard.keys"
+        input.importantForAutofill = View.IMPORTANT_FOR_AUTOFILL_NO
+        //the whole address is seen: it wraps on any character, not scrolled in one line
+        input.setHorizontallyScrolling(false)
+        input.maxLines = MAX_LINES
+        input.breakStrategy = android.graphics.text.LineBreaker.BREAK_STRATEGY_SIMPLE
+        input.showSoftInputOnFocus = false
+        input.isCursorVisible = false
+
+        input.setOnEditorActionListener { _, actionId, event ->
+            val enter = event != null && event.keyCode == KeyEvent.KEYCODE_ENTER
+            if (actionId == EditorInfo.IME_ACTION_GO || actionId == EditorInfo.IME_ACTION_DONE || enter) {
+                submit()
+                true
+            } else {
+                false
+            }
+        }
+        input.setOnKeyListener { _, keyCode, event ->
+            setKeyboardUp(false)
+            val down = event.action == KeyEvent.ACTION_DOWN
+            when (keyCode) {
+                KeyEvent.KEYCODE_DPAD_DOWN -> {
+                    if (down) openButton.requestFocus()
+                    true
+                }
+                KeyEvent.KEYCODE_DPAD_UP -> true
+                //the caret stops at the ends of the text, the focus does not leave it
+                KeyEvent.KEYCODE_DPAD_LEFT -> input.selectionStart == 0 && input.selectionEnd == 0
+                KeyEvent.KEYCODE_DPAD_RIGHT -> input.selectionEnd == input.length() && input.selectionStart == input.selectionEnd
+                KeyEvent.KEYCODE_DPAD_CENTER -> {
+                    if (event.action == KeyEvent.ACTION_UP) showKeyboard()
+                    true
+                }
+                KeyEvent.KEYCODE_ENTER, KeyEvent.KEYCODE_NUMPAD_ENTER -> {
+                    if (event.action == KeyEvent.ACTION_UP) submit()
+                    true
+                }
+                else -> false
+            }
+        }
+        input.setOnFocusChangeListener { _, focused -> if (focused) showFieldHint() }
+        input.doAfterTextChanged { warned = false }
+        return input.also {
+            it.layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+                topMargin = UxGlass.dp(context, 6f)
+            }
+        }
+    }
+
+    private fun buildButtons() {
+        val actions = addRow()
+        openButton = addButton(actions, R.string.ux_addr_open, R.string.ux_addr_hint_open, accent = true) { submit() }
+        addButton(actions, R.string.ux_addr_clear, R.string.ux_addr_hint_clear) {
+            input.setText("")
+            input.requestFocus()
+            showKeyboard()
+        }
+        addButton(actions, R.string.ux_addr_no_query, R.string.ux_addr_hint_no_query) {
+            val cut = AddressParts.withoutQuery(input.text.toString())
+            input.setText(cut)
+            input.setSelection(cut.length)
+            openButton.requestFocus()
+        }
+        addButton(actions, R.string.ux_addr_keyboard, R.string.ux_addr_hint_keyboard) { input.requestFocus(); showKeyboard() }
+        addButton(actions, R.string.ux_addr_search, R.string.ux_addr_hint_search) { close(restoreFocus = false); host.openSearch() }
+        val editing = addRow()
+        addButton(editing, R.string.ux_addr_prev, R.string.ux_addr_hint_prev, repeat = true) { input.setSelection(AddressParts.prevStop(input.text, input.selectionStart)) }
+        addButton(editing, R.string.ux_addr_next, R.string.ux_addr_hint_next, repeat = true) { input.setSelection(AddressParts.nextStop(input.text, input.selectionEnd)) }
+        val delete = addButton(editing, R.string.ux_addr_delete, R.string.ux_addr_hint_delete, repeat = true) { deleteBefore() }
+        delete.setOnFocusChangeListener { _, focused ->
+            if (focused) showHint(R.string.ux_addr_hint_delete)
+            markLeft = focused
+            input.invalidate()
+        }
+        addButton(editing, R.string.ux_addr_cut_right, R.string.ux_addr_hint_cut_right) { input.text.delete(input.selectionStart, input.length()) }
+    }
+
+    private fun addRow(): LinearLayout {
+        val row = LinearLayout(context)
+        row.orientation = LinearLayout.HORIZONTAL
+        row.gravity = Gravity.CENTER_HORIZONTAL
+        panel.addView(row, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+            topMargin = UxGlass.dp(context, 10f)
+        })
+        return row
+    }
+
+    private fun addButton(row: LinearLayout, textRes: Int, hintRes: Int, repeat: Boolean = false, accent: Boolean = false, action: () -> Unit): View {
+        val height = UxGlass.dp(context, BUTTON_HEIGHT_DP)
+        val radius = height / 2f
+        val b = TextView(context)
+        b.text = context.getString(textRes)
+        b.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+        b.gravity = Gravity.CENTER
+        b.setPadding(UxGlass.dp(context, 12f), 0, UxGlass.dp(context, 12f), 0)
+        b.isFocusable = true
+        b.isClickable = true
+        b.setTextColor(ColorStateList(arrayOf(intArrayOf(android.R.attr.state_focused), intArrayOf()), intArrayOf(0xFF16161C.toInt(), UxGlass.TEXT)))
+        b.background = StateListDrawable().apply {
+            addState(intArrayOf(android.R.attr.state_focused), UxGlass.rounded(0xFFFFFFFF.toInt(), radius))
+            addState(intArrayOf(), UxGlass.rounded(if (accent) 0x598FB8FF else UxGlass.VEIL, radius))
+        }
+        b.setOnClickListener { action() }
+        b.setOnFocusChangeListener { _, focused -> if (focused) showHint(hintRes) }
+        b.setOnKeyListener { _, keyCode, event ->
+            when (keyCode) {
+                //along its row only: a press at the end goes to the other end, a hold stops there
+                KeyEvent.KEYCODE_DPAD_LEFT, KeyEvent.KEYCODE_DPAD_RIGHT -> {
+                    if (event.action == KeyEvent.ACTION_DOWN) {
+                        val step = if (keyCode == KeyEvent.KEYCODE_DPAD_LEFT) -1 else 1
+                        val next = row.indexOfChild(b) + step
+                        val wrapped = if (event.repeatCount == 0) (next + row.childCount) % row.childCount else next
+                        row.getChildAt(wrapped)?.requestFocus()
+                    }
+                    true
+                }
+                KeyEvent.KEYCODE_DPAD_CENTER, KeyEvent.KEYCODE_ENTER, KeyEvent.KEYCODE_NUMPAD_ENTER -> {
+                    if (!repeat) return@setOnKeyListener false
+                    //held OK repeats it
+                    val now = SystemClock.uptimeMillis()
+                    if (event.action == KeyEvent.ACTION_DOWN && (event.repeatCount == 0 || now - lastRepeat >= REPEAT_MS)) {
+                        lastRepeat = now
+                        action()
+                    }
+                    true
+                }
+                else -> false
+            }
+        }
+        val lp = LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, height)
+        if (row.childCount > 0) lp.marginStart = UxGlass.dp(context, 6f)
+        row.addView(b, lp)
+        return b
+    }
+
+    private var lastRepeat = 0L
+
+    private fun showHint(res: Int) {
+        hint.setTextColor(UxGlass.TEXT_FAINT)
+        hint.text = context.getString(res)
+    }
+
+    private fun showFieldHint() = showHint(if (keyboardUp) R.string.ux_addr_hint_typing else R.string.ux_addr_hint_text)
+
+    /**
+     * The keyboard came or went. A keyboard over the page changes no layout and no insets the views get, so this is tracked
+     * here: it comes when asked for, a short Back takes it away, and any key that reaches the field means it is gone.
+     */
+    private fun setKeyboardUp(up: Boolean) {
+        if (up == keyboardUp) return
+        keyboardUp = up
+        input.isActivated = up
+        if (input.hasFocus()) showFieldHint()
+    }
+
+    private fun deleteBefore() {
+        val start = input.selectionStart
+        val end = input.selectionEnd
+        if (start != end) input.text.delete(start, end)
+        else if (start > 0) input.text.delete(start - 1, start)
+    }
+
+    /** The focus does not leave the panel for the bar under it */
+    override fun focusSearch(focused: View?, direction: Int): View? {
+        if (!isVisible || focused == null) return super.focusSearch(focused, direction)
+        return FocusFinder.getInstance().findNextFocus(panel, focused, direction) ?: focused
+    }
+
+    /** Shows the panel with the [address] in the field, no-op if it shows */
+    fun open(address: String) {
+        if (isVisible) return
+        original = address
+        warned = false
+        input.setText(address)
+        input.setSelection(address.length)
+        visibility = VISIBLE
+        backCallback.isEnabled = true
+        alpha = 0f
+        panel.translationY = -UxGlass.dp(context, 18f).toFloat()
+        animate().alpha(1f).setDuration(OPEN_MS).setInterpolator(DecelerateInterpolator()).start()
+        panel.animate().translationY(0f).setDuration(OPEN_MS).setInterpolator(DecelerateInterpolator()).start()
+        input.requestFocus()
+    }
+
+    /** Hides the panel; the focus goes back unless [restoreFocus] is false */
+    fun close(restoreFocus: Boolean = true) {
+        if (!isVisible) return
+        backCallback.isEnabled = false
+        hideKeyboard()
+        setKeyboardUp(false)
+        animate().cancel()
+        panel.animate().cancel()
+        visibility = GONE
+        if (restoreFocus) host.onClosed()
+    }
+
+    private fun showKeyboard() {
+        val imm = context.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
+        imm.showSoftInput(input, 0)
+        setKeyboardUp(true)
+    }
+
+    private fun hideKeyboard() {
+        val imm = context.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
+        imm.hideSoftInputFromWindow(input.windowToken, 0)
+    }
+
+    private fun submit() {
+        val text = input.text.toString().trim()
+        if (text.isEmpty()) return
+        close()
+        host.submit(text)
+    }
+
+    companion object {
+        private const val PANEL_WIDTH_DP = 860f
+        private const val BUTTON_HEIGHT_DP = 36f
+        private const val MAX_LINES = 4
+        private const val OPEN_MS = 160L
+        private const val REPEAT_MS = 110L
+        /** Held longer, Back erases on the keyboard and does not take it away */
+        private const val HOLD_BACK_MS = 500L
+    }
+}
diff --git b/app/src/main/java/com/phlox/tvwebbrowser/ux/AddressParts.kt b/app/src/main/java/com/phlox/tvwebbrowser/ux/AddressParts.kt
new file mode 100644
index 0000000..b5c267d
--- /dev/null
+++ b/app/src/main/java/com/phlox/tvwebbrowser/ux/AddressParts.kt
@@ -0,0 +1,36 @@
+package com.phlox.tvwebbrowser.ux
+
+/** The parts of an address for the keys of [AddressEditorView]: jumps over the separators and cutting its tail */
+object AddressParts {
+    private const val SEPARATORS = "/?&=#.:"
+
+    private fun isSeparator(c: Char) = SEPARATORS.indexOf(c) >= 0
+
+    /** Where the caret goes from [pos] one part back: to the start of the part (a row of separators counts as one) */
+    fun prevStop(text: CharSequence, pos: Int): Int {
+        var i = pos.coerceIn(0, text.length)
+        while (i > 0 && isSeparator(text[i - 1])) i--
+        while (i > 0 && !isSeparator(text[i - 1])) i--
+        return i
+    }
+
+    /** Where the caret goes from [pos] one part forward: to the start of the next part */
+    fun nextStop(text: CharSequence, pos: Int): Int {
+        var i = pos.coerceIn(0, text.length)
+        while (i < text.length && !isSeparator(text[i])) i++
+        while (i < text.length && isSeparator(text[i])) i++
+        return i
+    }
+
+    /** The address without its parameters: all from the first ? or #; the same text if it has none */
+    fun withoutQuery(text: String): String {
+        val q = text.indexOf('?')
+        val f = text.indexOf('#')
+        val cut = when {
+            q < 0 -> f
+            f < 0 -> q
+            else -> minOf(q, f)
+        }
+        return if (cut < 0) text else text.substring(0, cut)
+    }
+}
