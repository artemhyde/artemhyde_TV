+    /** The document a request comes from by its Referer; null if it has none, or none that is a web address */
+    private fun documentOf(request: WebResourceRequest): Uri? {
+        val referer = request.requestHeaders["Referer"] ?: return null
+        val uri = try {
+            referer.toUri()
+        } catch (e: Exception) {
+            return null
+        }
+        return uri.takeIf { (it.scheme == "http" || it.scheme == "https") && !it.host.isNullOrEmpty() }
+    }
