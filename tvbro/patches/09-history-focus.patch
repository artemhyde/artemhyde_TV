diff --git a/app/src/main/java/com/phlox/tvwebbrowser/activity/main/view/HistoryScreenView.kt b/app/src/main/java/com/phlox/tvwebbrowser/activity/main/view/HistoryScreenView.kt
--- a/app/src/main/java/com/phlox/tvwebbrowser/activity/main/view/HistoryScreenView.kt
