+package com.phlox.tvwebbrowser.ux
+
+import com.phlox.tvwebbrowser.AppContext
+
+/**
+ * Small switches of the remote-control additions of the TV UI. They live in the app prefs (no field in
+ * [com.phlox.tvwebbrowser.Config], so merges with the upstream do not touch it).
+ */
+object UxSettings {
+    const val TAP_SCROLL_KEY = "ux_tap_scroll"
+    const val SUGGESTIONS_KEY = "ux_suggestions"
+
+    private fun prefs() = AppContext.provideConfig().prefs
+
+    /**
+     * A short tap of Up or Down scrolls the page by 40% of the screen and a hold on with the cursor hidden;
+     * Up at the top of the page opens the address bar
+     */
+    var tapScroll: Boolean
+        get() = prefs().getBoolean(TAP_SCROLL_KEY, true)
+        set(value) {
+            prefs().edit().putBoolean(TAP_SCROLL_KEY, value).apply()
+        }
+
+    /** The address bar asks the search engine for suggestions (the typed text leaves the TV) */
+    var suggestions: Boolean
+        get() = prefs().getBoolean(SUGGESTIONS_KEY, true)
+        set(value) {
+            prefs().edit().putBoolean(SUGGESTIONS_KEY, value).apply()
+        }
+}
+
+/**
+ * Where the shell and the engines meet without knowing each other: the TV shell sets the functions while it
+ * lives, the cursor (module `common`) and the home page script interface (WebView engine) call them.
+ * All of them are called on the main thread; null while the shell does not listen (the phone UI).
+ */
+object UxHooks {
+    /** Whether the page of the current tab is scrolled to its very top */
+    @Volatile
+    var isPageAtTop: (() -> Boolean)? = null
+
+    /** A short tap of Up at the top of the page; true if the shell took it (the address bar opens) */
+    @Volatile
+    var onUpAtTop: (() -> Boolean)? = null
+
+    /** Opens the address bar with search suggestions over the page */
+    @Volatile
+    var openQuickBar: (() -> Unit)? = null
+
+    /** The hotkeys of page up and down: scrolls the page by a part of the screen (down or up) */
+    @Volatile
+    var scrollPage: ((down: Boolean) -> Unit)? = null
+
+    /** The cursor starts to scroll the page for a tap or a hold of Up or Down: the shell can check that the page moved */
+    @Volatile
+    var onScrollKey: (() -> Unit)? = null
+}
