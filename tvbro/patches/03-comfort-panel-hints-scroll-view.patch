diff --git a/app/src/main/java/com/phlox/tvwebbrowser/ux/HomeTilesSeed.kt b/app/src/main/java/com/phlox/tvwebbrowser/ux/HomeTilesSeed.kt
new file mode 100644
index 0000000..9a9b06f
--- /dev/null
+++ b/app/src/main/java/com/phlox/tvwebbrowser/ux/HomeTilesSeed.kt
@@ -0,0 +1,59 @@
+package com.phlox.tvwebbrowser.ux
+
+import android.content.SharedPreferences
+import com.phlox.tvwebbrowser.data.FavoritesRepository
+
+/**
+ * Puts popular sites of this region in the tiles of the home page, once, and only where the tiles are still the
+ * eight sites TV Bro puts there on its first start (`HomePageLinks.initialBookmarksSuggestions`) - never over
+ * tiles the user changed. The tiles are the bookmarks of the Home page folder, so they can be edited as always.
+ */
+object HomeTilesSeed {
+    private const val DONE_KEY = "ux_home_tiles_seeded"
+
+    /** The sites of the first start of TV Bro, in its order */
+    private val UPSTREAM = listOf(
+        "https://www.wikipedia.org", "https://www.reddit.com", "https://mytuner-radio.com", "https://www.instagram.com",
+        "https://www.imdb.com", "https://www.ebay.com", "https://itch.io/games/input-gamepad/platform-web", "https://www.bbc.com/news"
+    )
+
+    /** Title and address of the tiles; the icons come from the sites themselves (the app's cache of favicons) */
+    val TILES = listOf(
+        "YouTube" to "https://www.youtube.com/",
+        "Google" to "https://www.google.com/",
+        "Bing" to "https://www.bing.com/",
+        "Reddit" to "https://www.reddit.com/",
+        "Wikipedia" to "https://www.wikipedia.org/",
+        "Twitch" to "https://www.twitch.tv/",
+        "IMDb" to "https://www.imdb.com/",
+        "BBC News" to "https://www.bbc.com/news"
+    )
+
+    /**
+     * @return true if the tiles were replaced (the home page should load its links again). Empty tiles are left
+     * for the next start: the home page fills them with its own suggestions the first time it shows.
+     */
+    suspend fun run(favorites: FavoritesRepository, prefs: SharedPreferences): Boolean {
+        if (prefs.getBoolean(DONE_KEY, false)) return false
+        val tiles = favorites.homePageBookmarks().sortedBy { it.order }
+        if (tiles.isEmpty()) return false
+        val pristine = tiles.size == UPSTREAM.size && tiles.map { normalize(it.url) } == UPSTREAM.map(::normalize)
+        if (pristine) {
+            for ((tile, site) in tiles.zip(TILES)) {
+                tile.title = site.first
+                tile.url = site.second
+                tile.favicon = null
+                tile.description = null
+                tile.destUrl = null
+                tile.validUntil = null
+                tile.useful = false
+                favorites.save(tile)
+            }
+        }
+        //whatever the tiles are, they are not looked at again
+        prefs.edit().putBoolean(DONE_KEY, true).apply()
+        return pristine
+    }
+
+    private fun normalize(url: String?): String = url.orEmpty().trim().trimEnd('/').lowercase()
+}
diff --git a/app/src/main/java/com/phlox/tvwebbrowser/ux/PageVideoChipView.kt b/app/src/main/java/com/phlox/tvwebbrowser/ux/PageVideoChipView.kt
