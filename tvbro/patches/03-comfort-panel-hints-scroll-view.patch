diff --git a/app/src/main/assets/pages/home/ux.js b/app/src/main/assets/pages/home/ux.js
new file mode 100644
index 0000000..f6fd0d7
--- /dev/null
+++ b/app/src/main/assets/pages/home/ux.js
@@ -0,0 +1,73 @@
+//Additions of the TV UI to the home page; index.js stays the one of the upstream and runs first.
+//1. In TV Bro the search box opens the address bar of the app (the keyboard and the suggestions are the app's),
+//   the box itself takes no text.
+//2. Short lists of links (the history modes) get popular sites in the places that are free.
+(function () {
+    "use strict";
+
+    var popular = [
+        { title: "YouTube", url: "https://www.youtube.com/" },
+        { title: "Google", url: "https://www.google.com/" },
+        { title: "Bing", url: "https://www.bing.com/" },
+        { title: "Reddit", url: "https://www.reddit.com/" },
+        { title: "Wikipedia", url: "https://www.wikipedia.org/" },
+        { title: "Twitch", url: "https://www.twitch.tv/" },
+        { title: "IMDb", url: "https://www.imdb.com/" },
+        { title: "BBC News", url: "https://www.bbc.com/news" },
+        { title: "DuckDuckGo", url: "https://duckduckgo.com/" }
+    ];
+
+    var inApp = window.hasOwnProperty("TVBro");
+    var russian = (navigator.language || "").toLowerCase().indexOf("ru") === 0;
+
+    var input = document.getElementById("search-input");
+    input.placeholder = russian ? "Поиск или адрес" : "Search or address";
+
+    if (inApp && typeof window.TVBro.openSearch === "function") {
+        //no keyboard of its own: the field of the app is the field
+        input.readOnly = true;
+        var openSearch = function () { window.TVBro.openSearch(); };
+        input.addEventListener("click", openSearch);
+        input.addEventListener("focus", openSearch);
+    }
+
+    function hostOf(url) {
+        try {
+            return new URL(url).host.replace(/^www\./, "");
+        } catch (e) {
+            return url;
+        }
+    }
+
+    //the links of the page and then popular sites, up to the 8 places of the page, each site once
+    function topUp(links) {
+        var result = links.slice();
+        var seen = {};
+        result.forEach(function (link) { seen[hostOf(link.url)] = true; });
+        for (var i = 0; i < popular.length && result.length < 8; i++) {
+            var host = hostOf(popular[i].url);
+            if (!seen[host]) {
+                seen[host] = true;
+                result.push({ title: popular[i].title, url: popular[i].url });
+            }
+        }
+        return result;
+    }
+
+    //the bookmarks are the user's: free places stay free
+    var baseRender = window.renderLinks;
+    window.renderLinks = function (mode, links) {
+        if (links && mode !== "BOOKMARKS") {
+            links = topUp(links);
+        }
+        baseRender(mode, links);
+    };
+
+    if (!inApp) {
+        //opened in an ordinary browser (to look at the page): the same sites as in the app
+        baseRender("RECOMMENDATIONS", popular.slice(0, 8));
+    } else if (typeof recommendationsToDisplay !== "undefined" && recommendationsToDisplay.length > 0) {
+        //the app rendered the links before this script ran
+        window.renderLinks(homePageLinksMode, recommendationsToDisplay);
+    }
+})();
