+++ b/app/src/main/java/com/phlox/tvwebbrowser/ux/UxGlass.kt
@@ -0,0 +1,61 @@
+package com.phlox.tvwebbrowser.ux
+
+import android.content.Context
+import android.content.res.ColorStateList
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.StateListDrawable
+import android.widget.ImageView
+
+/**
+ * The look of the new panels of the TV UI: dark "glass" that is only a translucent fill (no blur and no
+ * shadow: the GPU of a TV box redraws a blurred layer on every frame), rounded corners of 12 to 16 dp and capsules.
+ * Same in the light and the dark theme: the page behind is dimmed, so light text always reads.
+ */
+object UxGlass {
+    const val SCRIM = 0x52000000
+    const val PANEL = 0xEB10151C.toInt()
+    const val PANEL_STROKE = 0x33FFFFFF
+    /** The field and the capsules at rest */
+    const val CAPSULE = 0x1FFFFFFF
+    const val CAPSULE_FIELD = 0x40000000
+    const val CAPSULE_STROKE = 0x24FFFFFF
+    const val FOCUSED = 0xFF2F6FE0.toInt()
+    const val FOCUSED_STROKE = 0xFFA5D0FF.toInt()
+    const val TEXT = 0xFFF5F7FA.toInt()
+    const val TEXT_FAINT = 0x99FFFFFF.toInt()
+    const val TEXT_HINT = 0x80FFFFFF.toInt()
+
+    const val PANEL_RADIUS_DP = 16f
+
+    fun dp(context: Context, value: Float): Int = (value * context.resources.displayMetrics.density + 0.5f).toInt()
+
+    fun rounded(fill: Int, radius: Float, stroke: Int = 0, strokeWidth: Int = 0): GradientDrawable = GradientDrawable().apply {
+        shape = GradientDrawable.RECTANGLE
+        cornerRadius = radius
+        setColor(fill)
+        if (strokeWidth > 0) setStroke(strokeWidth, stroke)
+    }
+
+    /** The glass panel */
+    fun panel(context: Context): GradientDrawable =
+        rounded(PANEL, dp(context, PANEL_RADIUS_DP).toFloat(), PANEL_STROKE, dp(context, 1f))
+
+    /** A capsule (a line of a list): at rest, and focused with the light ring of the bar buttons */
+    fun capsule(context: Context, height: Int): StateListDrawable {
+        val radius = height / 2f
+        val ring = dp(context, 1.5f)
+        val states = StateListDrawable()
+        states.addState(intArrayOf(android.R.attr.state_focused), rounded(FOCUSED, radius, FOCUSED_STROKE, ring))
+        states.addState(intArrayOf(android.R.attr.state_pressed), rounded(FOCUSED, radius, FOCUSED_STROKE, ring))
+        states.addState(intArrayOf(), rounded(CAPSULE, radius, CAPSULE_STROKE, dp(context, 1f)))
+        return states
+    }
+
+    /** An icon of the app (white paths) in the colour of the glass text */
+    fun icon(context: Context, resId: Int, sizeDp: Float, color: Int = TEXT): ImageView = ImageView(context).apply {
+        setImageResource(resId)
+        imageTintList = ColorStateList.valueOf(color)
+        importantForAccessibility = android.view.View.IMPORTANT_FOR_ACCESSIBILITY_NO
+        layoutParams = android.widget.LinearLayout.LayoutParams(dp(context, sizeDp), dp(context, sizeDp))
+    }
+}
diff --git a/app/src/main/java/com/phlox/tvwebbrowser/ux/UxShell.kt b/app/src/main/java/com/phlox/tvwebbrowser/ux/UxShell.kt
new file mode 100644
index 0000000..5505827
--- /dev/null
+++ b/app/src/main/java/com/phlox/tvwebbrowser/ux/UxShell.kt
@@ -0,0 +1,272 @@
+package com.phlox.tvwebbrowser.ux
+
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.view.KeyEvent
+import android.view.ViewGroup
+import android.widget.RelativeLayout
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.view.isVisible
+import androidx.lifecycle.lifecycleScope
+import com.phlox.tvwebbrowser.AppContext
+import com.phlox.tvwebbrowser.Config
+import com.phlox.tvwebbrowser.TVBro
+import com.phlox.tvwebbrowser.activity.main.BrowserShell
+import com.phlox.tvwebbrowser.webengine.PageVideo
+import com.phlox.tvwebbrowser.webengine.virtualCursor
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+
+/**
+ * The additions of the TV shell that keep to their own files: the address bar over the page
+ * ([QuickBarView]: Menu, Up at the top of the page, the search box of the home page, a hotkey) and the glass
+ * button that offers a found video ([PageVideoChipView]). [com.phlox.tvwebbrowser.activity.main.TvShell] only
+ * creates it, passes the keys, the scroll position, the found videos and the "page is covered" state to it.
+ */
+class UxShell(
+    private val activity: AppCompatActivity,
+    private val host: BrowserShell.Host,
+    private val root: RelativeLayout,
+    private val callbacks: Callbacks,
+) {
+    interface Callbacks {
+        /** The bar, a panel, a menu, a screen, the player or a fullscreen view covers the page */
+        fun isPageCovered(): Boolean
+        /** Plays the video in the built-in player from its start */
+        fun playVideo(video: PageVideo)
+        /** Opens the bar with the list of the videos of the page */
+        fun showVideoList()
+        /** The address bar closed: the focus goes back to the bar of the shell if it is open, else to the page */
+        fun restoreFocus()
+        /** The text of the address bar was sent (searched or opened): the bar of the shell, if open, goes away */
+        fun onAddressSent()
+    }
+
+    private val handler = Handler(Looper.getMainLooper())
+
+    private val quickBar = QuickBarView(activity, object : QuickBarView.Host {
+        override val scope: CoroutineScope get() = activity.lifecycleScope
+        override fun submit(text: String) {
+            host.search(text)
+            callbacks.onAddressSent()
+        }
+        override fun open(url: String) {
+            host.navigate(url)
+            callbacks.onAddressSent()
+        }
+        override fun onClosed() {
+            callbacks.restoreFocus()
+            maybeShowChip()
+        }
+        override val searchEngineName: String get() = AppContext.provideConfig().guessSearchEngineName()
+        override val incognito: Boolean get() = AppContext.provideConfig().incognitoMode
+    })
+
+    private val chip = PageVideoChipView(activity)
+
+    /** Back closes the address bar */
+    val backCallback get() = quickBar.backCallback
+
+    private var pageScrollY = 0
+    private var covered = false
+    private var pageKey: String? = null
+    private var videos: List<PageVideo> = emptyList()
+    private var videosFoundAt = 0L
+    /** The pages the chip was shown for: once for each */
+    private val chipPages = HashSet<String>()
+    private var chipShown = false
+    /** The OK key went down while the chip showed: its key up belongs to the chip too */
+    private var chipOkDown = false
+    private val hideChipRunnable = Runnable { hideChip(fade = true) }
+
+    /**
+     * Something of this shell covers the page, so the hint of the shell about a playing video waits: the address
+     * bar, the chip, and the pages the chip was shown for (one offer of the player per page is enough)
+     */
+    val coversPage: Boolean get() = quickBar.isVisible || chipShown || (pageKey != null && pageKey in chipPages)
+
+    fun attach() {
+        root.addView(quickBar, RelativeLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+        root.addView(chip, RelativeLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, UxGlass.dp(activity, 48f)).apply {
+            addRule(RelativeLayout.ALIGN_PARENT_TOP)
+            addRule(RelativeLayout.ALIGN_PARENT_END)
+            topMargin = UxGlass.dp(activity, 14f)
+            marginEnd = UxGlass.dp(activity, 16f)
+        })
+        UxHooks.isPageAtTop = { pageScrollY <= 0 }
+        UxHooks.onUpAtTop = { openQuickBar() }
+        UxHooks.openQuickBar = { openQuickBar() }
+        UxHooks.scrollPage = { down -> scrollPage(down) }
+        UxHooks.onScrollKey = { watchScroll() }
+        //the tiles of the home page, once, only if the user has not changed them
+        activity.lifecycleScope.launch {
+            val changed = try {
+                HomeTilesSeed.run(TVBro.container.data.favorites, AppContext.provideConfig().prefs)
+            } catch (e: Exception) {
+                false
+            }
+            if (changed) host.controller.homePageLinks.load()
+        }
+    }
+
+    fun detach() {
+        UxHooks.isPageAtTop = null
+        UxHooks.onUpAtTop = null
+        UxHooks.openQuickBar = null
+        UxHooks.scrollPage = null
+        UxHooks.onScrollKey = null
+        handler.removeCallbacksAndMessages(null)
+        quickBar.close(restoreFocus = false)
+    }
+
+    /** The activity stops: the bar goes with the keyboard, the page keeps the focus it had */
+    fun onStop() = quickBar.close(restoreFocus = false)
+
+    /**
+     * Opens the address bar over the page; false if something covers the page. The bar of the shell asks with
+     * [force]: it is open under the new bar, and the address of the page is in the field, selected.
+     */
+    fun openQuickBar(force: Boolean = false): Boolean {
+        if (quickBar.isVisible || (!force && callbacks.isPageCovered())) return false
+        hideChip(fade = false)
+        //the cursor would float over the dimmed page
+        cursorDelegate?.hideCursor()
+        val address = host.controller.currentTabState.value.url
+        quickBar.open(prefill = if (force && address != Config.HOME_PAGE_URL) address else "")
+        return true
+    }
+
+    /** The page of the current tab scrolled to [scrollY] pixels */
+    fun onPageScrolled(scrollY: Int) {
+        pageScrollY = scrollY
+    }
+
+    private val cursorDelegate get() = host.controller.currentTab.value?.webEngine?.virtualCursor?.getCursorDrawerDelegate()
+
+    /** The hotkeys of page up and down; nothing happens while something covers the page */
+    private fun scrollPage(down: Boolean) {
+        if (callbacks.isPageCovered() || quickBar.isVisible) return
+        cursorDelegate?.scrollPage(if (down) 1 else -1)
+    }
+
+    //Up and Down scroll the page while the cursor is hidden. A page that does not move (the home page, the end
+    //of a page) would look as if the keys were dead, so the cursor appears and the keys move it as they always did.
+    private var scrollKeyY = 0
+    private val showCursorRunnable = Runnable {
+        if (pageScrollY == scrollKeyY) cursorDelegate?.animateAppearing()
+    }
+
+    private fun watchScroll() {
+        scrollKeyY = pageScrollY
+        handler.removeCallbacks(showCursorRunnable)
+        handler.postDelayed(showCursorRunnable, SCROLL_CHECK_MS)
+    }
+
+    /** Another tab is shown: its page keeps the scroll it had */
+    fun onTabChanged() {
+        pageScrollY = host.controller.currentTab.value?.webEngine?.getView()?.scrollY ?: 0
+    }
+
+    /** The page of the tab: the tab and its address without the fragment; null: none */
+    fun setPage(key: String?) {
+        if (pageKey == key) return
+        pageKey = key
+        hideChip(fade = false)
+    }
+
+    /** The shell covers the page or no longer does (the bar, a panel, the player, fullscreen) */
+    fun setCovered(covered: Boolean) {
+        if (this.covered == covered) return
+        this.covered = covered
+        if (covered) hideChip(fade = false) else maybeShowChip()
+    }
+
+    /** The videos of the shown page other apps can play, as the Videos button of the bar counts them */
+    fun onPageVideos(videos: List<PageVideo>) {
+        this.videos = videos
+        if (videos.isEmpty()) {
+            hideChip(fade = false)
+            return
+        }
+        videosFoundAt = SystemClock.elapsedRealtime()
+        if (chipShown) chip.setVideos(videos.size) else maybeShowChip()
+    }
+
+    /** A key event before the page gets it; @return true if taken */
+    fun dispatchKeyEvent(event: KeyEvent): Boolean {
+        if ((chipShown || chipOkDown) && onChipKey(event)) return true
+        if (event.keyCode == KeyEvent.KEYCODE_MENU) {
+            //the key belongs to the bar while it shows (it closes it) and to the page when nothing is free to open
+            if (quickBar.isVisible) {
+                if (event.action == KeyEvent.ACTION_UP) quickBar.close()
+                return true
+            }
+            if (!callbacks.isPageCovered()) {
+                if (event.action == KeyEvent.ACTION_UP) openQuickBar()
+                return true
+            }
+        }
+        return false
+    }
+
+    private fun onChipKey(event: KeyEvent): Boolean {
+        when (event.keyCode) {
+            KeyEvent.KEYCODE_DPAD_CENTER, KeyEvent.KEYCODE_ENTER, KeyEvent.KEYCODE_NUMPAD_ENTER, KeyEvent.KEYCODE_BUTTON_A -> {
+                if (event.action == KeyEvent.ACTION_DOWN) {
+                    if (chipShown) {
+                        chipOkDown = true
+                        return true
+                    }
+                    return chipOkDown
+                }
+                if (event.action == KeyEvent.ACTION_UP && chipOkDown) {
+                    chipOkDown = false
+                    if (chipShown) activateChip()
+                    return true
+                }
+            }
+            //the user moves on in the page: the offer goes, the key is the page's
+            KeyEvent.KEYCODE_DPAD_UP, KeyEvent.KEYCODE_DPAD_DOWN, KeyEvent.KEYCODE_DPAD_LEFT, KeyEvent.KEYCODE_DPAD_RIGHT,
+            KeyEvent.KEYCODE_DPAD_UP_LEFT, KeyEvent.KEYCODE_DPAD_UP_RIGHT, KeyEvent.KEYCODE_DPAD_DOWN_LEFT,
+            KeyEvent.KEYCODE_DPAD_DOWN_RIGHT -> if (event.action == KeyEvent.ACTION_DOWN) hideChip(fade = true)
+        }
+        return false
+    }
+
+    private fun activateChip() {
+        val videos = videos
+        hideChip(fade = false)
+        when {
+            videos.size == 1 -> callbacks.playVideo(videos[0])
+            videos.size > 1 -> callbacks.showVideoList()
+        }
+    }
+
+    private fun maybeShowChip() {
+        val key = pageKey ?: return
+        if (chipShown || covered || quickBar.isVisible || videos.isEmpty() || key in chipPages) return
+        if (!AppContext.provideConfig().pageVideoHint) return
+        //a video found while something covered the page is no news when the page is free again
+        if (SystemClock.elapsedRealtime() - videosFoundAt > FRESH_MS) return
+        chipPages += key
+        chipShown = true
+        chip.setVideos(videos.size)
+        chip.appear()
+        handler.postDelayed(hideChipRunnable, SHOWN_MS)
+    }
+
+    private fun hideChip(fade: Boolean) {
+        handler.removeCallbacks(hideChipRunnable)
+        if (!chipShown) return
+        chipShown = false
+        chip.disappear(fade)
+    }
+
+    companion object {
+        private const val SHOWN_MS = 8000L
+        private const val FRESH_MS = 15000L
+        /** A tap scrolls for 320 ms: if the page has not moved by then, it will not */
+        private const val SCROLL_CHECK_MS = 500L
+    }
+}
