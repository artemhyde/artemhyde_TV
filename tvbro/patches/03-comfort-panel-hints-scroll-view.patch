index 0000000..00152fa
--- /dev/null
+++ b/app/common/src/main/java/com/phlox/tvwebbrowser/widgets/cursor/PageScrollKeys.kt
@@ -0,0 +1,117 @@
+package com.phlox.tvwebbrowser.widgets.cursor
+
+import android.os.Handler
+import android.os.Looper
+import android.view.KeyEvent
+
+/**
+ * What the Up and Down keys of the remote do on a page:
+ *  - a tap (released within [HOLD_MS]) scrolls the page by a part of the screen ([Host.flip]); at the top
+ *    of the page a tap of Up is offered to the shell first ([Host.upAtTop]: the address bar opens);
+ *  - a hold: with the cursor on screen the cursor moves as before ([Host.passToCursor]), with the cursor
+ *    hidden the page scrolls on ([Host.startHold]) until the key is released.
+ * The decision waits [HOLD_MS], so the first move of a held cursor starts that much later. Left, Right and
+ * OK are not handled here; OK wakes the cursor.
+ */
+class PageScrollKeys(private val host: Host) {
+    interface Host {
+        /** The setting is on and no click or grab is in progress */
+        fun isActive(): Boolean
+        /** The cursor is on screen (it hides after a few seconds without keys) */
+        fun isCursorShown(): Boolean
+        fun flip(direction: Int)
+        fun startHold(direction: Int)
+        fun stopHold()
+        /** The held key is the cursor's again: it gets the key down it would have had at [HOLD_MS] earlier */
+        fun passToCursor(event: KeyEvent, direction: Int)
+        /** A tap of Up: true if the page is at its top and the shell took the key */
+        fun upAtTop(): Boolean
+    }
+
+    private enum class State { IDLE, PENDING, SCROLLING, CURSOR }
+
+    private var state = State.IDLE
+    private var keyCode = 0
+    private var direction = 0
+    private var downEvent: KeyEvent? = null
+    private val handler = Handler(Looper.getMainLooper())
+    private val holdRunnable = Runnable { onHold() }
+
+    /**
+     * An Up (direction -1) or Down (1) key event.
+     * @return true if it is taken, false if the cursor handles it as before
+     */
+    fun onKey(event: KeyEvent, direction: Int): Boolean {
+        return when (event.action) {
+            KeyEvent.ACTION_DOWN -> onDown(event, direction)
+            KeyEvent.ACTION_UP -> onUp(event)
+            else -> false
+        }
+    }
+
+    private fun onDown(event: KeyEvent, direction: Int): Boolean {
+        if (event.repeatCount > 0) {
+            //the repeats of a key that was decided on: taken while the page waits or scrolls, the cursor's otherwise
+            return event.keyCode == keyCode && (state == State.PENDING || state == State.SCROLLING)
+        }
+        //the other key of the pair is held already: the cursor deals with it
+        if (state == State.CURSOR) return false
+        if (!host.isActive()) return false
+        if (state != State.IDLE) cancel()
+        state = State.PENDING
+        keyCode = event.keyCode
+        this.direction = direction
+        downEvent = event
+        handler.postDelayed(holdRunnable, HOLD_MS)
+        return true
+    }
+
+    private fun onUp(event: KeyEvent): Boolean {
+        if (event.keyCode != keyCode || state == State.IDLE) return false
+        val wasState = state
+        val wasDirection = direction
+        handler.removeCallbacks(holdRunnable)
+        state = State.IDLE
+        downEvent = null
+        keyCode = 0
+        return when (wasState) {
+            State.PENDING -> {
+                if (!(wasDirection < 0 && host.upAtTop())) host.flip(wasDirection)
+                true
+            }
+            State.SCROLLING -> {
+                host.stopHold()
+                true
+            }
+            //the cursor tracks this key: its own handler ends it
+            State.CURSOR, State.IDLE -> false
+        }
+    }
+
+    private fun onHold() {
+        val event = downEvent ?: return
+        if (state != State.PENDING) return
+        if (host.isCursorShown()) {
+            state = State.CURSOR
+            downEvent = null
+            host.passToCursor(event, direction)
+        } else {
+            state = State.SCROLLING
+            host.startHold(direction)
+        }
+    }
+
+    /** Forgets the key in flight (the cursor is turned off, another key came) */
+    fun cancel() {
+        handler.removeCallbacks(holdRunnable)
+        if (state == State.SCROLLING) host.stopHold()
+        state = State.IDLE
+        downEvent = null
+        keyCode = 0
+    }
+
+    companion object {
+        /** A key released earlier than this was a tap */
+        const val HOLD_MS = 200L
+    }
+}
diff --git a/app/common/src/main/java/com/phlox/tvwebbrowser/widgets/cursor/SmoothPageScroller.kt b/app/common/src/main/java/com/phlox/tvwebbrowser/widgets/cursor/SmoothPageScroller.kt
new file mode 100644
index 0000000..d3bcaf6
--- /dev/null
+++ b/app/common/src/main/java/com/phlox/tvwebbrowser/widgets/cursor/SmoothPageScroller.kt
@@ -0,0 +1,173 @@
+package com.phlox.tvwebbrowser.widgets.cursor
+
+import android.view.Choreographer
+import android.view.animation.PathInterpolator
+import kotlin.math.abs
+import kotlin.math.exp
+
+/**
+ * Scrolls the page smoothly, one step per frame, from the time of the frame (so a slow frame makes a longer
+ * step and the speed does not change):
+ *  - [flip]: a tap of Up or Down, [FLIP_FRACTION] of the page height with an ease out; taps in a row add up;
+ *  - [startHold] / [stopHold]: a hold, the speed grows to [HOLD_PAGES_PER_SECOND] pages per second within
+ *    [HOLD_RAMP_SECONDS] and, after the key is released, dies away in a few frames.
+ * The steps go to [Host.scrollBy], which is the scroller of the cursor (mouse wheel, view scrolling or the
+ * touch drag, whatever the page takes).
+ */
+class SmoothPageScroller(private val host: Host) {
+    interface Host {
+        /** The height of the area the page is shown in, pixels */
+        val pageHeight: Int
+        val isAttached: Boolean
+        /** Scrolls the page down by [dy] pixels (up if negative) */
+        fun scrollBy(dy: Int)
+        /** Nothing moves any more: the touch drag of a scroller that needs one ends */
+        fun onScrollEnded()
+    }
+
+    private val choreographer: Choreographer by lazy { Choreographer.getInstance() }
+
+    //a flip: [flipTotal] pixels on the curve in [FLIP_NANOS], [flipDone] of them already scrolled
+    private var flipTotal = 0f
+    private var flipDone = 0f
+    private var flipStart = 0L
+
+    //a hold: the direction (-1, 0, 1), when it started, the speed now (pixels per second, also while it dies away)
+    private var holdDirection = 0
+    private var holdStart = 0L
+    private var velocity = 0f
+
+    private var carry = 0f
+    private var lastFrame = 0L
+    private var scheduled = false
+
+    private val frameCallback = Choreographer.FrameCallback { frameTimeNanos -> onFrame(frameTimeNanos) }
+
+    /** Scrolls by a part of the page in the [direction] (-1 up, 1 down) */
+    fun flip(direction: Int) {
+        val height = host.pageHeight
+        if (height <= 0 || !host.isAttached) return
+        //a hold that dies away goes on under the flip
+        holdDirection = 0
+        //the unfinished part of the earlier flip joins the new one, at most two pages ahead
+        val limit = height * MAX_PAGES_AHEAD
+        flipTotal = ((flipTotal - flipDone) + direction * height * FLIP_FRACTION).coerceIn(-limit, limit)
+        flipDone = 0f
+        flipStart = 0L
+        schedule()
+    }
+
+    /** The key is held: the page speeds up in the [direction] until [stopHold] */
+    fun startHold(direction: Int) {
+        if (host.pageHeight <= 0 || !host.isAttached) return
+        flipTotal = 0f
+        flipDone = 0f
+        holdDirection = direction
+        holdStart = 0L
+        schedule()
+    }
+
+    fun stopHold() {
+        holdDirection = 0
+    }
+
+    /** Stops at once (the cursor is turned off, the view goes away) */
+    fun cancel() {
+        if (scheduled) {
+            choreographer.removeFrameCallback(frameCallback)
+            scheduled = false
+        }
+        val moving = flipTotal != 0f || holdDirection != 0 || velocity != 0f
+        reset()
+        if (moving) host.onScrollEnded()
+    }
+
+    private fun reset() {
+        flipTotal = 0f
+        flipDone = 0f
+        flipStart = 0L
+        holdDirection = 0
+        holdStart = 0L
+        velocity = 0f
+        carry = 0f
+        lastFrame = 0L
+    }
+
+    private fun schedule() {
+        if (scheduled) return
+        scheduled = true
+        choreographer.postFrameCallback(frameCallback)
+    }
+
+    private fun onFrame(now: Long) {
+        scheduled = false
+        if (!host.isAttached) {
+            reset()
+            return
+        }
+        val dt = if (lastFrame == 0L) FIRST_FRAME_SECONDS else ((now - lastFrame) / NANOS_PER_SECOND).coerceIn(MIN_FRAME_SECONDS, MAX_FRAME_SECONDS)
+        lastFrame = now
+
+        var move = 0f
+        if (flipTotal != 0f) {
+            if (flipStart == 0L) flipStart = now
+            val t = ((now - flipStart).toFloat() / FLIP_NANOS).coerceIn(0f, 1f)
+            val target = flipTotal * FLIP_CURVE.getInterpolation(t)
+            move += target - flipDone
+            flipDone = target
+            if (t >= 1f) {
+                flipTotal = 0f
+                flipDone = 0f
+                flipStart = 0L
+            }
+        }
+        if (holdDirection != 0) {
+            if (holdStart == 0L) holdStart = now
+            val ramp = ((now - holdStart) / NANOS_PER_SECOND / HOLD_RAMP_SECONDS).coerceIn(0f, 1f)
+            //smoothstep: starts and arrives softly
+            val eased = ramp * ramp * (3f - 2f * ramp)
+            velocity = holdDirection * host.pageHeight * HOLD_PAGES_PER_SECOND * eased
+            move += velocity * dt
+        } else if (velocity != 0f) {
+            velocity *= exp(-dt / COAST_SECONDS)
+            if (abs(velocity) < MIN_COAST_SPEED) velocity = 0f
+            move += velocity * dt
+        }
+
+        carry += move
+        val whole = carry.toInt()
+        if (whole != 0) {
+            carry -= whole
+            host.scrollBy(whole)
+        }
+
+        if (flipTotal != 0f || holdDirection != 0 || velocity != 0f) {
+            schedule()
+        } else {
+            carry = 0f
+            lastFrame = 0L
+            host.onScrollEnded()
+        }
+    }
+
+    companion object {
+        /** A tap scrolls by this part of the page height */
+        const val FLIP_FRACTION = 0.4f
+        private const val MAX_PAGES_AHEAD = 2f
+        private const val FLIP_NANOS = 320_000_000L
+        /** Pages per second at full speed of a hold */
+        const val HOLD_PAGES_PER_SECOND = 1.6f
+        private const val HOLD_RAMP_SECONDS = 0.35f
+        /** The time constant of the speed dying away after a hold */
+        private const val COAST_SECONDS = 0.09f
+        private const val MIN_COAST_SPEED = 40f
+
+        private const val NANOS_PER_SECOND = 1_000_000_000f
+        private const val FIRST_FRAME_SECONDS = 1f / 60f
+        private const val MIN_FRAME_SECONDS = 0.004f
+        private const val MAX_FRAME_SECONDS = 0.05f
+
+        /** Starts with a push, slows down to a soft stop */
+        private val FLIP_CURVE = PathInterpolator(0.25f, 0.1f, 0.1f, 1f)
+    }
+}
