+    SCROLL_PAGE_UP(R.string.ux_shortcut_scroll_up, "shortcut_scroll_page_up", KeyBinding(KeyEvent.KEYCODE_CHANNEL_UP)),
+    SCROLL_PAGE_DOWN(R.string.ux_shortcut_scroll_down, "shortcut_scroll_page_down", KeyBinding(KeyEvent.KEYCODE_CHANNEL_DOWN));
 }
 
