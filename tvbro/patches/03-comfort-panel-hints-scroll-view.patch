@@ -0,0 +1,383 @@
+/*
+The home page of the TV: dark glass, a big search pill and a grid of 4x2 tiles. Sizes are parts of the
+screen width (vw), so the page looks the same on any TV resolution. No blur, no shadows, no animation but a
+short transition of the hovered tile (the cursor of the browser hovers like a mouse): the GPU of a TV box is weak.
+*/
+:root {
+    --glass: rgba(255, 255, 255, 0.09);
+    --glass-hi: rgba(255, 255, 255, 0.18);
+    --line: rgba(255, 255, 255, 0.16);
+    --ring: #a5d0ff;
+    --ink: #f4f7fb;
+    --ink-soft: rgba(244, 247, 251, 0.6);
+    --menu: rgba(16, 21, 28, 0.97);
+}
+
+* {
+    box-sizing: border-box;
+}
+
+html, body {
+    margin: 0;
+    padding: 0;
+    width: 100%;
+    height: 100%;
+}
+
+body {
+    color: var(--ink);
+    background-color: #0b0f14;
+    background-image: radial-gradient(120% 80% at 50% -10%, #223149 0%, #121a26 48%, #0b0f14 100%);
+    font-family: Roboto, "Noto Sans", sans-serif;
+    overflow: hidden;
+    -webkit-user-select: none;
+    user-select: none;
+}
+
+.page {
+    position: absolute;
+    left: 0;
+    top: 0;
+    width: 100%;
+    height: 100%;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    padding-top: 15vh;
+    overflow: hidden;
+}
+
+/* the search pill */
+.wrapper {
+    width: 62vw;
+}
+
+.search_box {
+    display: flex;
+    align-items: center;
+    height: 6.8vw;
+    padding: 0 1.1vw;
+    border-radius: 3.4vw;
+    background: var(--glass);
+    border: 0.15vw solid var(--line);
+}
+
+.dropdown {
+    position: relative;
+    width: 6.2vw;
+    height: 100%;
+    display: flex;
+    align-items: center;
+    cursor: pointer;
+}
+
+.dropdown .default_option {
+    width: 3.8vw;
+    height: 3.8vw;
+    margin-left: 0.7vw;
+    border-radius: 0.9vw;
+    background: url(favicons/google.png) no-repeat center;
+    background-size: contain;
+}
+
+.dropdown:before {
+    content: "";
+    position: absolute;
+    top: 3.2vw;
+    right: 0.7vw;
+    border: 0.5vw solid transparent;
+    border-top-color: var(--ink-soft);
+}
+
+.dropdown ul {
+    display: none;
+    position: absolute;
+    top: 100%;
+    left: 0;
+    z-index: 5;
+    width: 20vw;
+    margin: 0.5vw 0 0;
+    padding: 0.8vw;
+    list-style: none;
+    font-size: 1.9vw;
+    color: var(--ink);
+    background: var(--menu);
+    border: 0.12vw solid var(--line);
+    border-radius: 1.5vw;
+}
+
+.dropdown ul.active {
+    display: block;
+}
+
+.dropdown ul li {
+    display: flex;
+    align-items: center;
+    padding: 0.7vw 0.9vw;
+    border-radius: 1vw;
+}
+
+.dropdown ul li:hover {
+    background: var(--glass-hi);
+}
+
+.dropdown ul li img {
+    width: 2.4vw;
+    height: 2.4vw;
+    margin-right: 1vw;
+}
+
+.search_field {
+    flex: 1;
+    min-width: 0;
+    height: 100%;
+    display: flex;
+    align-items: center;
+    border-left: 0.12vw solid var(--line);
+}
+
+.search_field .input {
+    flex: 1;
+    min-width: 0;
+    height: 100%;
+    margin: 0;
+    padding: 0 1.4vw;
+    border: 0;
+    outline: none;
+    background: transparent;
+    color: var(--ink);
+    font-family: inherit;
+    font-size: 2.3vw;
+}
+
+.search_field .input::placeholder {
+    color: var(--ink-soft);
+}
+
+.search_action_container {
+    width: 4.8vw;
+    height: 4.8vw;
+    border-radius: 50%;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    cursor: pointer;
+}
+
+.search_action_container:hover {
+    background: var(--glass-hi);
+}
+
+.search_action_container .mic,
+.search_action_container .lenz {
+    width: 2.4vw;
+    height: 2.4vw;
+    background-repeat: no-repeat;
+    background-position: center;
+    background-size: contain;
+}
+
+.search_action_container .mic {
+    background-image: url(mic.svg);
+}
+
+.search_action_container .lenz {
+    background-image: url(search.svg);
+    display: none;
+}
+
+/* the tiles */
+#suggestions {
+    width: 62vw;
+    margin-top: 6vh;
+    display: grid;
+    grid-template-columns: repeat(4, 1fr);
+    gap: 1.5vw;
+}
+
+.cell {
+    min-width: 0;
+    cursor: pointer;
+}
+
+.sugg {
+    position: relative;
+    height: 11.2vw;
+    padding: 1vw 0.8vw;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    border-radius: 1.8vw;
+    background: var(--glass);
+    border: 0.15vw solid var(--line);
+    transition: background-color 0.12s, border-color 0.12s, transform 0.12s;
+}
+
+.cell:hover .sugg {
+    background: var(--glass-hi);
+    border-color: var(--ring);
+    transform: translateY(-0.25vw);
+}
+
+.sugg-ico {
+    width: 5vw;
+    height: 5vw;
+    padding: 0.5vw;
+    margin: 0 0 1vw;
+    border-radius: 1.2vw;
+    background: #ffffff;
+    object-fit: contain;
+}
+
+.sugg-title {
+    display: block;
+    max-width: 100%;
+    font-size: 1.75vw;
+    font-weight: 600;
+    line-height: 2.4vw;
+    text-align: center;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.sugg-title.empty {
+    visibility: hidden;
+}
+
+/* the description (the address) takes room the tile needs for the icon */
+.sugg-desk {
+    display: none;
+}
+
+/* a free place of the grid of bookmarks */
+.sugg:has(.sugg-title.empty) {
+    opacity: 0.25;
+}
+
+.more {
+    display: none;
+    position: absolute;
+    top: 0.5vw;
+    right: 0.5vw;
+    width: 2vw;
+    height: 2vw;
+    padding: 0.45vw;
+    border-radius: 50%;
+    filter: invert(1);
+    cursor: pointer;
+}
+
+.more:hover {
+    background: var(--glass-hi);
+}
+
+/* a light page where the system theme is light */
+@media (prefers-color-scheme: light) {
+    :root {
+        --glass: rgba(255, 255, 255, 0.72);
+        --glass-hi: #ffffff;
+        --line: rgba(20, 40, 70, 0.16);
+        --ring: #2f6fe0;
+        --ink: #1b2430;
+        --ink-soft: rgba(27, 36, 48, 0.55);
+        --menu: rgba(255, 255, 255, 0.98);
+    }
+    body {
+        background-color: #e9f0f8;
+        background-image: radial-gradient(120% 80% at 50% -10%, #ffffff 0%, #e9f0f8 60%, #dbe6f2 100%);
+    }
+    .sugg-ico {
+        background: #f3f6fa;
+    }
+    .more {
+        filter: none;
+    }
+}
+
+/* phones (narrow, or short in landscape): sizes in CSS pixels, two columns */
+@media (max-width: 600px), (max-height: 420px) {
+    .page {
+        padding-top: 24px;
+    }
+    .wrapper, #suggestions {
+        width: calc(100% - 32px);
+        max-width: 576px;
+    }
+    .search_box {
+        height: 48px;
+        padding: 0 8px;
+        border-radius: 24px;
+    }
+    .dropdown {
+        width: 52px;
+    }
+    .dropdown .default_option {
+        width: 28px;
+        height: 28px;
+        margin-left: 6px;
+        border-radius: 6px;
+    }
+    .dropdown:before {
+        top: 21px;
+        right: 4px;
+        border-width: 4px;
+    }
+    .dropdown ul {
+        width: 200px;
+        padding: 8px;
+        font-size: 16px;
+        border-radius: 12px;
+    }
+    .dropdown ul li {
+        padding: 8px;
+        border-radius: 8px;
+    }
+    .dropdown ul li img {
+        width: 20px;
+        height: 20px;
+        margin-right: 8px;
+    }
+    .search_field .input {
+        padding: 0 12px;
+        font-size: 16px;
+    }
+    .search_action_container {
+        width: 40px;
+        height: 40px;
+    }
+    .search_action_container .mic,
+    .search_action_container .lenz {
+        width: 22px;
+        height: 22px;
+    }
+    #suggestions {
+        margin-top: 24px;
+        grid-template-columns: repeat(2, 1fr);
+        gap: 12px;
+    }
+    .sugg {
+        height: 88px;
+        padding: 8px;
+        border-radius: 12px;
+    }
+    .sugg-ico {
+        width: 36px;
+        height: 36px;
+        padding: 4px;
+        margin-bottom: 6px;
+        border-radius: 8px;
+    }
+    .sugg-title {
+        font-size: 14px;
+        line-height: 18px;
+    }
+    .more {
+        width: 24px;
+        height: 24px;
+        padding: 6px;
+        top: 2px;
+        right: 2px;
+    }
+}
