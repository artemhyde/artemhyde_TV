@@ -0,0 +1,82 @@
+package com.phlox.tvwebbrowser.ux
+
+import android.content.Context
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.phlox.tvwebbrowser.R
+
+/**
+ * The glass button in the corner of the page that offers a found video: "Open in the player on the full
+ * screen" with the key that does it (OK). It takes no focus and no keys; [UxShell] gives it the OK key while it shows.
+ */
+class PageVideoChipView(context: Context) : LinearLayout(context) {
+    private val label = TextView(context)
+    private val cap = TextView(context)
+
+    init {
+        orientation = HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+        val height = UxGlass.dp(context, HEIGHT_DP)
+        background = UxGlass.rounded(UxGlass.PANEL, height / 2f, UxGlass.FOCUSED_STROKE, UxGlass.dp(context, 1.5f))
+        setPadding(UxGlass.dp(context, 16f), 0, UxGlass.dp(context, 10f), 0)
+        isFocusable = false
+        descendantFocusability = FOCUS_BLOCK_DESCENDANTS
+        accessibilityLiveRegion = ACCESSIBILITY_LIVE_REGION_POLITE
+        outlineProvider = null
+        elevation = UxGlass.dp(context, 6.2f).toFloat()
+        visibility = GONE
+
+        addView(UxGlass.icon(context, R.drawable.ic_play, 24f))
+
+        label.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18f)
+        label.setTextColor(UxGlass.TEXT)
+        label.isSingleLine = true
+        addView(label, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT).apply {
+            marginStart = UxGlass.dp(context, 10f)
+        })
+
+        cap.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        cap.setTextColor(UxGlass.TEXT)
+        cap.text = context.getString(R.string.ux_key_ok)
+        cap.gravity = Gravity.CENTER
+        val capHeight = UxGlass.dp(context, 28f)
+        cap.minWidth = UxGlass.dp(context, 40f)
+        cap.setPadding(UxGlass.dp(context, 10f), 0, UxGlass.dp(context, 10f), 0)
+        cap.background = UxGlass.rounded(UxGlass.CAPSULE, capHeight / 2f, UxGlass.TEXT_FAINT, UxGlass.dp(context, 1f))
+        addView(cap, LayoutParams(LayoutParams.WRAP_CONTENT, capHeight).apply {
+            marginStart = UxGlass.dp(context, 14f)
+        })
+    }
+
+    /** One video is opened at once, several are listed */
+    fun setVideos(count: Int) {
+        label.text = if (count <= 1) context.getString(R.string.ux_chip_open_player)
+        else context.getString(R.string.ux_chip_choose_video, count)
+    }
+
+    fun appear() {
+        animate().cancel()
+        if (visibility != VISIBLE) alpha = 0f
+        visibility = VISIBLE
+        animate().alpha(1f).setDuration(FADE_IN_MS).start()
+    }
+
+    fun disappear(fade: Boolean) {
+        if (visibility != VISIBLE) return
+        animate().cancel()
+        if (!fade) {
+            visibility = View.GONE
+            return
+        }
+        animate().alpha(0f).setDuration(FADE_OUT_MS).withEndAction { visibility = View.GONE }.start()
+    }
+
+    companion object {
+        private const val HEIGHT_DP = 48f
+        private const val FADE_IN_MS = 250L
+        private const val FADE_OUT_MS = 350L
+    }
+}
diff --git a/app/src/main/java/com/phlox/tvwebbrowser/ux/QuickBarView.kt b/app/src/main/java/com/phlox/tvwebbrowser/ux/QuickBarView.kt
new file mode 100644
index 0000000..c7444a8
--- /dev/null
+++ b/app/src/main/java/com/phlox/tvwebbrowser/ux/QuickBarView.kt
@@ -0,0 +1,367 @@
+package com.phlox.tvwebbrowser.ux
+
+import android.content.Context
+import android.os.Build
+import android.text.Editable
+import android.text.InputType
+import android.text.TextUtils
+import android.text.TextWatcher
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.KeyEvent
+import android.view.View
+import android.view.ViewGroup
+import android.view.animation.DecelerateInterpolator
+import android.view.inputmethod.EditorInfo
+import android.view.inputmethod.InputMethodManager
+import android.widget.EditText
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.activity.OnBackPressedCallback
+import androidx.core.view.isVisible
+import com.phlox.tvwebbrowser.R
+import com.phlox.tvwebbrowser.TVBro
+import com.phlox.tvwebbrowser.model.FavoriteItem
+import com.phlox.tvwebbrowser.model.HistoryItem
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+
+/**
+ * The address bar over the page: a glass panel at the top with the field, under it the capsules of the
+ * suggestions (the typed text, bookmarks, history, queries of the search engine). It takes the keys while it
+ * shows and gives the focus back to the page when it goes. Opened by the Menu key, Up at the top of the page,
+ * the search box of the home page and the hotkey "address bar"; Back or Menu close it.
+ *
+ * Down moves from the field to the capsules, Up back; OK on a capsule opens it; Enter in the field searches
+ * the text (an address is opened). With the soft keyboard up the keys belong to it: Back hides it first.
+ */
+class QuickBarView(context: Context, private val host: Host) : FrameLayout(context) {
+    interface Host {
+        val scope: CoroutineScope
+        /** Searches the text or opens it as an address */
+        fun submit(text: String)
+        /** Opens a page of the history or the bookmarks */
+        fun open(url: String)
+        /** The bar went away: the page gets the focus back */
+        fun onClosed()
+        /** Which search engine suggests queries, see [com.phlox.tvwebbrowser.Config.guessSearchEngineName] */
+        val searchEngineName: String
+        /** Nothing typed goes to the network in the incognito mode */
+        val incognito: Boolean
+    }
+
+    private val panel = LinearLayout(context)
+    private val input = EditText(context)
+    private val list = LinearLayout(context)
+    private val hint = TextView(context)
+
+    private var history: List<HistoryItem> = emptyList()
+    private var bookmarks: List<FavoriteItem> = emptyList()
+    /** The queries the search engine suggested for [webQuery] */
+    private var web: List<String> = emptyList()
+    private var webQuery = ""
+    private var webJob: Job? = null
+    private var shown: List<Suggestion> = emptyList()
+    /** The list was not rebuilt (a capsule had the focus): do it when the focus is back in the field */
+    private var rebuildPending = false
+    private var submitted = false
+
+    /** Back closes the bar while it shows */
+    val backCallback = object : OnBackPressedCallback(false) {
+        override fun handleOnBackPressed() = close()
+    }
+
+    init {
+        visibility = GONE
+        setBackgroundColor(UxGlass.SCRIM)
+        isFocusable = false
+        //a shadow of a translucent view is a heavy layer for the GPU of a TV
+        outlineProvider = null
+        elevation = UxGlass.dp(context, 7.9f).toFloat()
+
+        panel.orientation = LinearLayout.VERTICAL
+        panel.background = UxGlass.panel(context)
+        val pad = UxGlass.dp(context, 12f)
+        panel.setPadding(pad, pad, pad, UxGlass.dp(context, 8f))
+        val width = minOf(UxGlass.dp(context, PANEL_WIDTH_DP), context.resources.displayMetrics.widthPixels - 2 * UxGlass.dp(context, 24f))
+        addView(panel, LayoutParams(width, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP or Gravity.CENTER_HORIZONTAL).apply {
+            topMargin = UxGlass.dp(context, 24f)
+        })
+
+        panel.addView(buildField())
+        list.orientation = LinearLayout.VERTICAL
+        panel.addView(list, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+            topMargin = UxGlass.dp(context, 8f)
+        })
+
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+        hint.setTextColor(UxGlass.TEXT_HINT)
+        hint.text = context.getString(R.string.ux_quick_hint)
+        hint.gravity = Gravity.CENTER
+        panel.addView(hint, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+            topMargin = UxGlass.dp(context, 8f)
+        })
+    }
+
+    /** The field: a capsule with the search glass and the text */
+    private fun buildField(): View {
+        val row = LinearLayout(context)
+        row.orientation = LinearLayout.HORIZONTAL
+        row.gravity = Gravity.CENTER_VERTICAL
+        val height = UxGlass.dp(context, FIELD_HEIGHT_DP)
+        row.background = UxGlass.rounded(UxGlass.CAPSULE_FIELD, height / 2f, UxGlass.FOCUSED_STROKE, UxGlass.dp(context, 1.5f))
+        row.setPadding(UxGlass.dp(context, 18f), 0, UxGlass.dp(context, 18f), 0)
+        row.layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, height)
+
+        val glass = UxGlass.icon(context, R.drawable.ic_search, 22f)
+        row.addView(glass)
+
+        input.background = null
+        input.setTextSize(TypedValue.COMPLEX_UNIT_SP, 21f)
+        input.setTextColor(UxGlass.TEXT)
+        input.setHintTextColor(UxGlass.TEXT_HINT)
+        input.highlightColor = 0x665FACFF
+        input.hint = context.getString(R.string.ux_quick_field_hint)
+        input.isSingleLine = true
+        input.maxLines = 1
+        input.inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_URI or InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
+        input.imeOptions = EditorInfo.IME_ACTION_GO or EditorInfo.IME_FLAG_NO_EXTRACT_UI
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) input.importantForAutofill = View.IMPORTANT_FOR_AUTOFILL_NO
+        input.setPadding(UxGlass.dp(context, 12f), 0, 0, 0)
+        row.addView(input, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.MATCH_PARENT, 1f))
+
+        input.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: Editable?) = onQueryChanged()
+        })
+        input.setOnEditorActionListener { _, actionId, event ->
+            val enter = event != null && event.keyCode == KeyEvent.KEYCODE_ENTER
+            if (actionId == EditorInfo.IME_ACTION_GO || actionId == EditorInfo.IME_ACTION_SEARCH ||
+                actionId == EditorInfo.IME_ACTION_DONE || enter) {
+                submitTyped()
+                true
+            } else {
+                false
+            }
+        }
+        input.setOnKeyListener { _, keyCode, event ->
+            when (keyCode) {
+                KeyEvent.KEYCODE_DPAD_DOWN -> {
+                    //a single-line field would move its caret; Down belongs to the capsules
+                    if (list.childCount == 0) return@setOnKeyListener false
+                    if (event.action == KeyEvent.ACTION_DOWN) list.getChildAt(0).requestFocus()
+                    true
+                }
+                KeyEvent.KEYCODE_ENTER, KeyEvent.KEYCODE_NUMPAD_ENTER -> {
+                    if (event.action == KeyEvent.ACTION_UP) submitTyped()
+                    true
+                }
+                else -> false
+            }
+        }
+        input.setOnFocusChangeListener { _, focused ->
+            if (focused && rebuildPending) rebuild()
+        }
+        return row
+    }
+
+    /**
+     * Shows the bar with the keyboard; no-op if it shows. The field is empty or has the [prefill] (an address to
+     * edit), selected.
+     */
+    fun open(prefill: String = "") {
+        if (isVisible) return
+        submitted = false
+        web = emptyList()
+        webQuery = ""
+        rebuildPending = false
+        input.setText(prefill)
+        rebuild()
+        visibility = VISIBLE
+        backCallback.isEnabled = true
+        alpha = 0f
+        panel.translationY = -UxGlass.dp(context, 18f).toFloat()
+        animate().alpha(1f).setDuration(OPEN_MS).setInterpolator(DecelerateInterpolator()).start()
+        panel.animate().translationY(0f).setDuration(OPEN_MS).setInterpolator(DecelerateInterpolator()).start()
+        input.requestFocus()
+        postDelayed({ if (isVisible && input.hasFocus()) showKeyboard() }, KEYBOARD_DELAY_MS)
+        //some keyboards of TVs drop a selection made before they show
+        if (prefill.isNotEmpty()) postDelayed({ if (isVisible) input.selectAll() }, SELECT_DELAY_MS)
+        host.scope.launch {
+            val data = TVBro.container.data
+            history = try { data.history.all() } catch (e: Exception) { emptyList() }
+            bookmarks = try { data.favorites.all().filter { it.url != null } } catch (e: Exception) { emptyList() }
+            if (isVisible && !list.hasFocus()) rebuild()
+        }
+    }
+
+    /** Hides the bar; the page gets the focus back unless [restoreFocus] is false */
+    fun close(restoreFocus: Boolean = true) {
+        if (!isVisible) return
+        webJob?.cancel()
+        backCallback.isEnabled = false
+        hideKeyboard()
+        animate().cancel()
+        panel.animate().cancel()
+        visibility = GONE
+        if (restoreFocus) host.onClosed()
+    }
+
+    private fun showKeyboard() {
+        val imm = context.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
+        imm.showSoftInput(input, 0)
+    }
+
+    private fun hideKeyboard() {
+        val imm = context.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
+        imm.hideSoftInputFromWindow(input.windowToken, 0)
+    }
+
+    private fun submitTyped() {
+        val text = input.text.toString().trim()
+        if (text.isEmpty() || submitted) return
+        submitted = true
+        close(restoreFocus = true)
+        host.submit(text)
+    }
+
+    private fun activate(item: Suggestion) {
+        if (submitted) return
+        submitted = true
+        close(restoreFocus = true)
+        when (item.kind) {
+            Suggestion.Kind.BOOKMARK, Suggestion.Kind.HISTORY -> item.url?.let { host.open(it) }
+            Suggestion.Kind.TYPED, Suggestion.Kind.WEB -> host.submit(item.text)
+        }
+    }
+
+    private fun onQueryChanged() {
+        rebuild()
+        webJob?.cancel()
+        val query = input.text.toString().trim()
+        if (query.isEmpty() || host.incognito || !UxSettings.suggestions || !SuggestionsProvider.mayAskNetwork(query)) {
+            web = emptyList()
+            webQuery = ""
+            return
+        }
+        webJob = host.scope.launch {
+            //the request waits for the typing to pause; typing on cancels it, also while it runs
+            delay(DEBOUNCE_MS)
+            val answer = SuggestionsProvider.web(query, host.searchEngineName)
+            web = answer
+            webQuery = query
+            if (input.text.toString().trim() == query) {
+                if (list.hasFocus()) rebuildPending = true else rebuild()
+            }
+        }
+    }
+
+    /** Fills the list: the typed text, then the pages found in memory, then the queries of the search engine */
+    private fun rebuild() {
+        if (list.hasFocus()) {
+            rebuildPending = true
+            return
+        }
+        rebuildPending = false
+        val query = input.text.toString().trim()
+        val items = ArrayList<Suggestion>(MAX_ROWS)
+        if (query.isNotEmpty()) items += Suggestion(Suggestion.Kind.TYPED, query)
+        items += SuggestionsProvider.local(query, history, bookmarks, if (query.isEmpty()) MAX_ROWS else MAX_LOCAL_ROWS)
+        //queries asked for a shorter text still fit the longer one while the new answer is on its way
+        val queries = if (webQuery.isNotEmpty() && query.startsWith(webQuery, ignoreCase = true)) web else emptyList()
+        for (q in queries) {
+            if (items.size >= MAX_ROWS) break
+            if (!q.startsWith(query, ignoreCase = true) || q.equals(query, ignoreCase = true)) continue
+            if (items.none { it.text.equals(q, ignoreCase = true) }) items += Suggestion(Suggestion.Kind.WEB, q)
+        }
+        if (items == shown) return
+        shown = items
+        list.removeAllViews()
+        for ((index, item) in items.withIndex()) list.addView(buildRow(item, index, items.size))
+    }
+
+    private fun buildRow(item: Suggestion, index: Int, count: Int): View {
+        val height = UxGlass.dp(context, ROW_HEIGHT_DP)
+        val row = LinearLayout(context)
+        row.orientation = LinearLayout.HORIZONTAL
+        row.gravity = Gravity.CENTER_VERTICAL
+        row.isFocusable = true
+        row.isClickable = true
+        row.background = UxGlass.capsule(context, height)
+        row.setPadding(UxGlass.dp(context, 18f), 0, UxGlass.dp(context, 18f), 0)
+        row.layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, height).apply {
+            if (index > 0) topMargin = UxGlass.dp(context, 4f)
+        }
+
+        val iconRes = when (item.kind) {
+            Suggestion.Kind.TYPED -> if (SuggestionsProvider.looksLikeAddress(item.text)) R.drawable.ic_globe else R.drawable.ic_search
+            Suggestion.Kind.BOOKMARK -> R.drawable.ic_star
+            Suggestion.Kind.HISTORY -> R.drawable.ic_history
+            Suggestion.Kind.WEB -> R.drawable.ic_search
+        }
+        row.addView(UxGlass.icon(context, iconRes, 20f, if (item.kind == Suggestion.Kind.TYPED) UxGlass.TEXT else UxGlass.TEXT_FAINT))
+
+        val title = TextView(context)
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 17f)
+        title.setTextColor(UxGlass.TEXT)
+        title.isSingleLine = true
+        title.ellipsize = TextUtils.TruncateAt.END
+        title.text = when (item.kind) {
+            Suggestion.Kind.TYPED -> context.getString(
+                if (SuggestionsProvider.looksLikeAddress(item.text)) R.string.ux_open_address else R.string.ux_search_for, item.text)
+            else -> item.text
+        }
+        row.addView(title, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f).apply {
+            marginStart = UxGlass.dp(context, 12f)
+        })
+
+        if (item.url != null) {
+            val site = TextView(context)
+            site.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+            site.setTextColor(UxGlass.TEXT_FAINT)
+            site.isSingleLine = true
+            site.ellipsize = TextUtils.TruncateAt.END
+            site.maxWidth = UxGlass.dp(context, 220f)
+            site.text = SuggestionsProvider.siteOf(item.url)
+            row.addView(site, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+                marginStart = UxGlass.dp(context, 12f)
+            })
+        }
+
+        row.setOnClickListener { activate(item) }
+        row.setOnKeyListener { _, keyCode, event ->
+            when (keyCode) {
+                KeyEvent.KEYCODE_DPAD_UP -> {
+                    if (event.action == KeyEvent.ACTION_DOWN) {
+                        if (index == 0) input.requestFocus() else list.getChildAt(index - 1).requestFocus()
+                    }
+                    true
+                }
+                KeyEvent.KEYCODE_DPAD_DOWN -> {
+                    if (event.action == KeyEvent.ACTION_DOWN && index < count - 1) list.getChildAt(index + 1).requestFocus()
+                    true
+                }
+                KeyEvent.KEYCODE_DPAD_LEFT, KeyEvent.KEYCODE_DPAD_RIGHT -> true
+                else -> false
+            }
+        }
+        return row
+    }
+
+    companion object {
+        private const val PANEL_WIDTH_DP = 680f
+        private const val FIELD_HEIGHT_DP = 48f
+        private const val ROW_HEIGHT_DP = 36f
+        /** The keyboard of a TV covers the lower part of the window: the list has to end above it (about 330 dp of 540) */
+        private const val MAX_ROWS = 5
+        private const val MAX_LOCAL_ROWS = 2
+        private const val DEBOUNCE_MS = 200L
+        private const val OPEN_MS = 160L
+        private const val KEYBOARD_DELAY_MS = 150L
+        private const val SELECT_DELAY_MS = 500L
+    }
+}
diff --git a/app/src/main/java/com/phlox/tvwebbrowser/ux/SuggestionsProvider.kt b/app/src/main/java/com/phlox/tvwebbrowser/ux/SuggestionsProvider.kt
new file mode 100644
index 0000000..453f1d8
--- /dev/null
+++ b/app/src/main/java/com/phlox/tvwebbrowser/ux/SuggestionsProvider.kt
@@ -0,0 +1,230 @@
+package com.phlox.tvwebbrowser.ux
+
+import android.util.Patterns
+import com.phlox.tvwebbrowser.Config
+import com.phlox.tvwebbrowser.model.FavoriteItem
+import com.phlox.tvwebbrowser.model.HistoryItem
+import com.phlox.tvwebbrowser.net.AppProxy
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONException
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+import java.nio.charset.Charset
+import java.util.Locale
+
+/** A line of the list under the address field of the quick bar */
+data class Suggestion(
+    val kind: Kind,
+    /** What the line says; for a page of the history or the bookmarks its title */
+    val text: String,
+    /** The address a page of the history or the bookmarks opens */
+    val url: String? = null,
+) {
+    enum class Kind {
+        /** What is typed in the field: search it or open it */
+        TYPED,
+        BOOKMARK,
+        HISTORY,
+        /** A query the search engine suggests */
+        WEB
+    }
+}
+
+/**
+ * Suggestions for the quick bar: pages of the bookmarks and the history (found in memory) and queries the
+ * search engine suggests. The typed text goes to the network only when it looks like words, never when it looks
+ * like an address (it may carry a secret), not in incognito mode and not when the setting is off.
+ */
+object SuggestionsProvider {
+    /** Where queries are suggested; all answer with a JSON array */
+    enum class Source(private val template: String) {
+        GOOGLE("https://suggestqueries.google.com/complete/search?client=firefox&hl=%2\$s&q=%1\$s"),
+        DUCKDUCKGO("https://duckduckgo.com/ac/?q=%1\$s"),
+        YANDEX("https://suggest.yandex.ru/suggest-ff.cgi?part=%1\$s"),
+        BING("https://api.bing.com/osjson.aspx?query=%1\$s");
+
+        fun urlFor(query: String, language: String): String =
+            template.format(URLEncoder.encode(query, "UTF-8"), language)
+    }
+
+    private const val CONNECT_TIMEOUT_MS = 2500
+    private const val READ_TIMEOUT_MS = 2500
+    private const val MAX_RESPONSE_BYTES = 64 * 1024
+    private const val MAX_QUERY_LENGTH = 100
+    private const val USER_AGENT = "Mozilla/5.0 (Linux; Android 14; TV) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
+
+    private val DOMAIN_LIKE = Regex("^[\\w.-]+\\.[a-zA-Z]{2,}(:\\d+)?$")
+
+    /** The sources to try, in order, for the search engine named as [Config.guessSearchEngineName] does */
+    fun sourcesFor(engineName: String): List<Source> = when (engineName) {
+        "ddg" -> listOf(Source.DUCKDUCKGO, Source.GOOGLE)
+        "yandex" -> listOf(Source.YANDEX, Source.GOOGLE)
+        "bing" -> listOf(Source.BING, Source.GOOGLE)
+        else -> listOf(Source.GOOGLE, Source.DUCKDUCKGO)
+    }
+
+    /** Whether the typed [query] may leave the TV: words, not an address or something long */
+    fun mayAskNetwork(query: String): Boolean {
+        val text = query.trim()
+        if (text.isEmpty() || text.length > MAX_QUERY_LENGTH) return false
+        if (text.contains("://") || text.contains('/') || text.contains('@')) return false
+        return !DOMAIN_LIKE.matches(text)
+    }
+
+    /** The text is an address to open, not words to search (as [com.phlox.tvwebbrowser.browser.UrlInputResolver] decides) */
+    fun looksLikeAddress(text: String): Boolean {
+        val lower = text.trim().lowercase(Locale.ROOT)
+        return Patterns.WEB_URL.matcher(text).matches() || lower.startsWith("http://") || lower.startsWith("https://")
+    }
+
+    /** The queries of an answer: `["query", ["a", "b"]]` (Google, Yandex, Bing, DuckDuckGo with a type) or `[{"phrase": "a"}]` (DuckDuckGo) */
+    fun parse(body: String): List<String> {
+        val start = body.indexOf('[')
+        if (start < 0) return emptyList()
+        val root = try {
+            JSONArray(body.substring(start).trim())
+        } catch (e: JSONException) {
+            return emptyList()
+        }
+        val result = ArrayList<String>()
+        val second = root.opt(1)
+        if (root.opt(0) is String && second is JSONArray) {
+            for (i in 0 until second.length()) (second.opt(i) as? String)?.let { result += it }
+        } else {
+            for (i in 0 until root.length()) root.optJSONObject(i)?.optString("phrase")?.let { result += it }
+        }
+        return result.map { it.trim() }.filter { it.isNotEmpty() }.distinct()
+    }
+
+    /**
+     * The queries suggested for [query]: from the first source that answers, the next one is tried when a
+     * source fails (an empty answer is an answer). Cancelling the caller closes the connection.
+     */
+    suspend fun web(query: String, engineName: String): List<String> {
+        if (!mayAskNetwork(query)) return emptyList()
+        val language = Locale.getDefault().language.ifBlank { "ru" }
+        for (source in sourcesFor(engineName)) {
+            val answer = try {
+                fetch(source.urlFor(query.trim(), language))
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                null
+            }
+            if (answer != null) return answer
+        }
+        return emptyList()
+    }
+
+    private suspend fun fetch(address: String): List<String>? = coroutineScope {
+        val connection = AppProxy.open(URL(address)) as? HttpURLConnection ?: return@coroutineScope null
+        //reading blocks the thread: cancelling the caller closes the connection, and the read fails
+        val closer = launch(Dispatchers.Default) {
+            try {
+                awaitCancellation()
+            } finally {
+                connection.disconnect()
+            }
+        }
+        try {
+            withContext(Dispatchers.IO) { read(connection) }
+        } finally {
+            closer.cancel()
+        }
+    }
+
+    private fun read(connection: HttpURLConnection): List<String>? {
+        return try {
+            connection.connectTimeout = CONNECT_TIMEOUT_MS
+            connection.readTimeout = READ_TIMEOUT_MS
+            connection.instanceFollowRedirects = true
+            connection.setRequestProperty("User-Agent", USER_AGENT)
+            connection.setRequestProperty("Accept", "application/json, text/javascript, */*")
+            if (connection.responseCode != HttpURLConnection.HTTP_OK) return null
+            val charset = charsetOf(connection.contentType)
+            val out = ByteArrayOutputStream()
+            connection.inputStream.use { input ->
+                val buffer = ByteArray(4096)
+                while (out.size() < MAX_RESPONSE_BYTES) {
+                    val n = input.read(buffer)
+                    if (n < 0) break
+                    out.write(buffer, 0, n)
+                }
+            }
+            parse(String(out.toByteArray(), charset))
+        } catch (e: IOException) {
+            null
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun charsetOf(contentType: String?): Charset {
+        val name = contentType?.substringAfter("charset=", "")?.substringBefore(';')?.trim()?.trim('"')
+        return try {
+            if (name.isNullOrEmpty()) Charsets.UTF_8 else Charset.forName(name)
+        } catch (e: Exception) {
+            Charsets.UTF_8
+        }
+    }
+
+    /**
+     * Pages of the [bookmarks] and the [history] (latest first) that have every word of the [query] in the title or
+     * the address: up to two bookmarks (those whose title starts with the query first), then the history, [limit] in
+     * all, each page once. Without a query: the latest pages, one per site.
+     */
+    fun local(query: String, history: List<HistoryItem>, bookmarks: List<FavoriteItem>, limit: Int): List<Suggestion> {
+        val words = query.trim().split(Regex("\\s+")).filter { it.isNotEmpty() }
+        val result = ArrayList<Suggestion>()
+        val seenPages = HashSet<String>()
+        val seenSites = HashSet<String>()
+
+        fun add(kind: Suggestion.Kind, title: String?, url: String?): Boolean {
+            if (url.isNullOrBlank() || isInternal(url)) return false
+            if (!seenPages.add(pageKey(url))) return false
+            if (words.isEmpty() && !seenSites.add(siteOf(url))) return false
+            result += Suggestion(kind, title?.takeIf { it.isNotBlank() } ?: url, url)
+            return true
+        }
+
+        fun matches(title: String?, url: String?): Boolean = words.all {
+            title?.contains(it, ignoreCase = true) == true || url?.contains(it, ignoreCase = true) == true
+        }
+
+        if (words.isNotEmpty()) {
+            val found = bookmarks.filter { it.url != null && matches(it.title, it.url) }
+                .sortedBy { if (it.title?.startsWith(query.trim(), ignoreCase = true) == true) 0 else 1 }
+            var added = 0
+            for (b in found) {
+                if (added >= MAX_BOOKMARKS || result.size >= limit) break
+                if (add(Suggestion.Kind.BOOKMARK, b.title, b.url)) added++
+            }
+        }
+        for (h in history) {
+            if (result.size >= limit) break
+            if (words.isEmpty() || matches(h.title, h.url)) add(Suggestion.Kind.HISTORY, h.title, h.url)
+        }
+        return result
+    }
+
+    private const val MAX_BOOKMARKS = 2
+
+    private fun isInternal(url: String) = url == Config.HOME_URL_ALIAS || url.startsWith(Config.HOME_PAGE_URL) ||
+            url.startsWith("about:") || url.startsWith("file:") || url.startsWith("data:")
+
+    /** The address without the scheme, "www.", the fragment and the closing slash, lower case */
+    fun pageKey(url: String): String = url.lowercase(Locale.ROOT).substringBefore('#')
+        .removePrefix("https://").removePrefix("http://").removePrefix("www.").trimEnd('/')
+
+    /** "example.com" of "https://www.example.com/a" */
+    fun siteOf(url: String): String = pageKey(url).substringBefore('/').substringBefore('?')
+}
diff --git a/app/src/main/java/com/phlox/tvwebbrowser/ux/UxGlass.kt b/app/src/main/java/com/phlox/tvwebbrowser/ux/UxGlass.kt
