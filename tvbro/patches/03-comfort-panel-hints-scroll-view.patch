+package com.phlox.tvwebbrowser.widgets.cursor
+
+import android.os.Looper
+import android.view.KeyEvent
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import java.time.Duration
+
+/** Taps and holds of Up and Down: page flips, continuous scrolling and the hand-over to the cursor */
+@RunWith(RobolectricTestRunner::class)
+class PageScrollKeysTest {
+    private val log = ArrayList<String>()
+    private var active = true
+    private var cursorShown = false
+    private var atTop = false
+    private var shellTakesUp = true
+
+    private val keys = PageScrollKeys(object : PageScrollKeys.Host {
+        override fun isActive() = active
+        override fun isCursorShown() = cursorShown
+        override fun flip(direction: Int) { log += "flip $direction" }
+        override fun startHold(direction: Int) { log += "hold $direction" }
+        override fun stopHold() { log += "stop" }
+        override fun passToCursor(event: KeyEvent, direction: Int) { log += "cursor $direction" }
+        override fun upAtTop(): Boolean {
+            log += "top?"
+            return atTop && shellTakesUp
+        }
+    })
+
+    private fun event(action: Int, keyCode: Int, repeat: Int = 0) = KeyEvent(0L, 0L, action, keyCode, repeat)
+
+    private fun down(keyCode: Int = KeyEvent.KEYCODE_DPAD_DOWN, repeat: Int = 0) =
+        keys.onKey(event(KeyEvent.ACTION_DOWN, keyCode, repeat), if (keyCode == KeyEvent.KEYCODE_DPAD_UP) -1 else 1)
+
+    private fun up(keyCode: Int = KeyEvent.KEYCODE_DPAD_DOWN) =
+        keys.onKey(event(KeyEvent.ACTION_UP, keyCode), if (keyCode == KeyEvent.KEYCODE_DPAD_UP) -1 else 1)
+
+    private fun idle(ms: Long) = shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(ms))
+
+    @Test
+    fun aTapFlipsThePage() {
+        assertTrue(down())
+        idle(PageScrollKeys.HOLD_MS - 50)
+        assertTrue(up())
+        assertEquals(listOf("flip 1"), log)
+        idle(1000)
+        assertEquals(listOf("flip 1"), log)
+    }
+
+    @Test
+    fun aTapOfUpFlipsUpWhenThePageIsNotAtItsTop() {
+        down(KeyEvent.KEYCODE_DPAD_UP)
+        up(KeyEvent.KEYCODE_DPAD_UP)
+        assertEquals(listOf("top?", "flip -1"), log)
+    }
+
+    @Test
+    fun aTapOfUpAtTheTopGoesToTheShellAndDoesNotFlip() {
+        atTop = true
+        down(KeyEvent.KEYCODE_DPAD_UP)
+        assertTrue(up(KeyEvent.KEYCODE_DPAD_UP))
+        assertEquals(listOf("top?"), log)
+    }
+
+    @Test
+    fun aTapOfUpAtTheTopFlipsIfTheShellDoesNotTakeIt() {
+        atTop = true
+        shellTakesUp = false
+        down(KeyEvent.KEYCODE_DPAD_UP)
+        up(KeyEvent.KEYCODE_DPAD_UP)
+        assertEquals(listOf("top?", "flip -1"), log)
+    }
+
+    @Test
+    fun aTapOfDownNeverAsksForTheTop() {
+        atTop = true
+        down()
+        up()
+        assertEquals(listOf("flip 1"), log)
+    }
+
+    @Test
+    fun aHoldWithTheCursorHiddenScrollsUntilTheKeyGoesUp() {
+        down()
+        idle(PageScrollKeys.HOLD_MS)
+        assertEquals(listOf("hold 1"), log)
+        //the repeats of the key are taken, so the cursor does not see them
+        assertTrue(down(repeat = 1))
+        assertTrue(down(repeat = 2))
+        assertTrue(up())
+        assertEquals(listOf("hold 1", "stop"), log)
+    }
+
+    @Test
+    fun aHoldWithTheCursorOnScreenMovesTheCursorAsBefore() {
+        cursorShown = true
+        down(KeyEvent.KEYCODE_DPAD_UP)
+        idle(PageScrollKeys.HOLD_MS)
+        assertEquals(listOf("cursor -1"), log)
+        //the cursor tracks the key: repeats and the key up are its own
+        assertFalse(down(KeyEvent.KEYCODE_DPAD_UP, repeat = 1))
+        assertFalse(up(KeyEvent.KEYCODE_DPAD_UP))
+        assertEquals(listOf("cursor -1"), log)
+    }
+
+    @Test
+    fun keysAreLeftToTheCursorWhileAClickOrGrabIsOn() {
+        active = false
+        assertFalse(down())
+        assertFalse(up())
+        assertEquals(emptyList<String>(), log)
+    }
+
+    @Test
+    fun aKeyUpWithoutItsKeyDownIsNotTaken() {
+        assertFalse(up())
+        assertEquals(emptyList<String>(), log)
+    }
+
+    @Test
+    fun theOtherKeyAfterAHoldStartsItsOwnPress() {
+        down()
+        idle(PageScrollKeys.HOLD_MS)
+        assertTrue(down(KeyEvent.KEYCODE_DPAD_UP))
+        up(KeyEvent.KEYCODE_DPAD_UP)
+        assertEquals(listOf("hold 1", "stop", "top?", "flip -1"), log)
+    }
+
+    @Test
+    fun cancelStopsAHoldAndForgetsAPendingKey() {
+        down()
+        idle(PageScrollKeys.HOLD_MS)
+        keys.cancel()
+        assertEquals(listOf("hold 1", "stop"), log)
+        assertFalse(up())
+
+        log.clear()
+        down()
+        keys.cancel()
+        idle(1000)
+        assertEquals(emptyList<String>(), log)
+    }
+}
