diff --git a/app/src/test/java/com/phlox/tvwebbrowser/ux/SuggestionsProviderTest.kt b/app/src/test/java/com/phlox/tvwebbrowser/ux/SuggestionsProviderTest.kt
new file mode 100644
index 0000000..a45f1e1
--- /dev/null
+++ b/app/src/test/java/com/phlox/tvwebbrowser/ux/SuggestionsProviderTest.kt
@@ -0,0 +1,143 @@
+package com.phlox.tvwebbrowser.ux
+
+import com.phlox.tvwebbrowser.model.FavoriteItem
+import com.phlox.tvwebbrowser.model.HistoryItem
+import com.phlox.tvwebbrowser.ux.SuggestionsProvider.Source
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+
+@RunWith(RobolectricTestRunner::class)
+class SuggestionsProviderTest {
+    private fun history(title: String, url: String) = HistoryItem().apply { this.title = title; this.url = url }
+
+    private fun bookmark(title: String, url: String?) = FavoriteItem().apply { this.title = title; this.url = url }
+
+    @Test
+    fun readsTheAnswerOfGoogleYandexBingAndDuckDuckGoWithAType() {
+        val answer = """["пого",["погода","погода париж"],[],{"google:suggestsubtypes":[[512],[433]]}]"""
+        assertEquals(listOf("погода", "погода париж"), SuggestionsProvider.parse(answer))
+        assertEquals(listOf("pogo", "pogo sign in"), SuggestionsProvider.parse("""["pogo",["pogo","pogo sign in"]]"""))
+    }
+
+    @Test
+    fun readsThePhrasesOfDuckDuckGo() {
+        val answer = """[{"phrase":"pogo"},{"phrase":"pogo sign in"},{"phrase":" "},{"other":1}]"""
+        assertEquals(listOf("pogo", "pogo sign in"), SuggestionsProvider.parse(answer))
+    }
+
+    @Test
+    fun brokenAnswersGiveNothing() {
+        assertEquals(emptyList<String>(), SuggestionsProvider.parse(""))
+        assertEquals(emptyList<String>(), SuggestionsProvider.parse("<html>blocked</html>"))
+        assertEquals(emptyList<String>(), SuggestionsProvider.parse("[1,2"))
+        assertEquals(emptyList<String>(), SuggestionsProvider.parse("[]"))
+    }
+
+    @Test
+    fun repeatedQueriesCountOnce() {
+        assertEquals(listOf("a", "b"), SuggestionsProvider.parse("""["q",["a","b","a"]]"""))
+    }
+
+    @Test
+    fun addressesAndLongTextsNeverGoToTheNetwork() {
+        assertTrue(SuggestionsProvider.mayAskNetwork("погода"))
+        assertTrue(SuggestionsProvider.mayAskNetwork("how to cook"))
+        assertFalse(SuggestionsProvider.mayAskNetwork(""))
+        assertFalse(SuggestionsProvider.mayAskNetwork("   "))
+        assertFalse(SuggestionsProvider.mayAskNetwork("https://example.com/path?token=1"))
+        assertFalse(SuggestionsProvider.mayAskNetwork("example.com/login"))
+        assertFalse(SuggestionsProvider.mayAskNetwork("example.com"))
+        assertFalse(SuggestionsProvider.mayAskNetwork("example.com:8080"))
+        assertFalse(SuggestionsProvider.mayAskNetwork("me@example.com"))
+        assertFalse(SuggestionsProvider.mayAskNetwork("x".repeat(101)))
+    }
+
+    @Test
+    fun theSourceFollowsTheSearchEngineAndFallsBackToGoogleOrDuckDuckGo() {
+        assertEquals(listOf(Source.GOOGLE, Source.DUCKDUCKGO), SuggestionsProvider.sourcesFor("google"))
+        assertEquals(listOf(Source.GOOGLE, Source.DUCKDUCKGO), SuggestionsProvider.sourcesFor("custom"))
+        assertEquals(listOf(Source.DUCKDUCKGO, Source.GOOGLE), SuggestionsProvider.sourcesFor("ddg"))
+        assertEquals(listOf(Source.YANDEX, Source.GOOGLE), SuggestionsProvider.sourcesFor("yandex"))
+        assertEquals(listOf(Source.BING, Source.GOOGLE), SuggestionsProvider.sourcesFor("bing"))
+    }
+
+    @Test
+    fun addressesOfTheSourcesCarryTheEncodedQuery() {
+        assertEquals("https://suggestqueries.google.com/complete/search?client=firefox&hl=ru&q=%D0%BF%D0%BE%D0%B3%D0%BE+%D0%B4%D0%B0",
+            Source.GOOGLE.urlFor("пого да", "ru"))
+        assertEquals("https://duckduckgo.com/ac/?q=a+b", Source.DUCKDUCKGO.urlFor("a b", "ru"))
+        assertEquals("https://suggest.yandex.ru/suggest-ff.cgi?part=x", Source.YANDEX.urlFor("x", "ru"))
+        assertEquals("https://api.bing.com/osjson.aspx?query=x", Source.BING.urlFor("x", "ru"))
+    }
+
+    @Test
+    fun addressAndWordsAreTold() {
+        assertTrue(SuggestionsProvider.looksLikeAddress("example.com"))
+        assertTrue(SuggestionsProvider.looksLikeAddress("https://example.com/a"))
+        assertFalse(SuggestionsProvider.looksLikeAddress("погода париж"))
+    }
+
+    @Test
+    fun localPagesNeedEveryWordInTheTitleOrTheAddress() {
+        val items = listOf(
+            history("Погода в Париже", "https://pogoda.example/paris"),
+            history("Новости", "https://news.example/"),
+            history("Погода в Москве", "https://pogoda.example/moscow"),
+        )
+        val found = SuggestionsProvider.local("погода пар", items, emptyList(), 5)
+        assertEquals(listOf("https://pogoda.example/paris"), found.map { it.url })
+        assertTrue(found.all { it.kind == Suggestion.Kind.HISTORY })
+    }
+
+    @Test
+    fun bookmarksComeFirstTitleStartsFirstAndAtMostTwo() {
+        val bookmarks = listOf(
+            bookmark("Мой youtube", "https://a.example/"),
+            bookmark("YouTube", "https://www.youtube.com/"),
+            bookmark("Другой youtube", "https://b.example/"),
+        )
+        val items = listOf(history("YouTube Music", "https://music.youtube.com/"))
+        val found = SuggestionsProvider.local("youtube", items, bookmarks, 5)
+        assertEquals(listOf("https://www.youtube.com/", "https://a.example/", "https://music.youtube.com/"), found.map { it.url })
+        assertEquals(listOf(Suggestion.Kind.BOOKMARK, Suggestion.Kind.BOOKMARK, Suggestion.Kind.HISTORY), found.map { it.kind })
+    }
+
+    @Test
+    fun aPageIsListedOnceWhateverTheSchemeWwwOrSlash() {
+        val items = listOf(
+            history("Example", "https://www.example.com/"),
+            history("Example again", "http://example.com"),
+        )
+        assertEquals(1, SuggestionsProvider.local("example", items, emptyList(), 5).size)
+        assertEquals(1, SuggestionsProvider.local("example", items, listOf(bookmark("Example", "https://example.com")), 5).size)
+    }
+
+    @Test
+    fun withoutAQueryTheLatestPagesOfDifferentSitesAreListedAndTheHomePageIsNot() {
+        val items = listOf(
+            history("Home", "about:home"),
+            history("A1", "https://a.example/1"),
+            history("A2", "https://a.example/2"),
+            history("B", "https://b.example/"),
+        )
+        val found = SuggestionsProvider.local("", items, emptyList(), 5)
+        assertEquals(listOf("https://a.example/1", "https://b.example/"), found.map { it.url })
+    }
+
+    @Test
+    fun theLimitHolds() {
+        val items = (1..20).map { history("Page $it", "https://site$it.example/") }
+        assertEquals(3, SuggestionsProvider.local("page", items, emptyList(), 3).size)
+        assertEquals(6, SuggestionsProvider.local("", items, emptyList(), 6).size)
+    }
+
+    @Test
+    fun theSiteOfAnAddress() {
+        assertEquals("example.com", SuggestionsProvider.siteOf("https://www.example.com/a/b?x=1"))
+        assertEquals("example.com:8080", SuggestionsProvider.siteOf("http://example.com:8080/"))
+    }
+}
