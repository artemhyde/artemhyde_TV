@@ -0,0 +1,25 @@
+package com.phlox.tvwebbrowser.webengine.webview
+
+import android.content.Context
+import android.webkit.WebView
+import androidx.webkit.WebViewCompat
+import androidx.webkit.WebViewFeature
+
+/**
+ * A script for every frame (also of other sites) that tells what a player does and what stops it: the clicks that
+ * reach the frame, `play()` and why it fails, `window.open`, errors of media and scripts, cookies and storage in a
+ * frame of another site. It only watches (it changes no behavior of the page) and writes `console.log` lines
+ * that start with `TVBRO-DIAG`, which `WebChromeClient.onConsoleMessage` of [WebViewEx] puts in logcat under the
+ * tag `TV Bro WebView`. Installed only while "Engine debugging" of the settings is on.
+ */
+internal object WebViewPlayerDiag {
+    private var script: String? = null
+
+    fun install(webView: WebView) {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) return
+        WebViewCompat.addDocumentStartJavaScript(webView, script(webView.context), setOf("*"))
+    }
+
+    private fun script(context: Context): String = script
+        ?: context.assets.open("player_diag.js").bufferedReader().use { it.readText() }.also { script = it }
+}
