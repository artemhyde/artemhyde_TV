+// Diagnostics of players in pages (WebViewPlayerDiag.kt). WebView runs it at the start of every document of every
+// frame, also of other sites, while "Engine debugging" of the settings is on. It only watches: the lines start
+// with TVBRO-DIAG and reach logcat (tag "TV Bro WebView") through onConsoleMessage of WebViewEx.
+(function () {
+  if (window.__tvBroDiag) return;
+  window.__tvBroDiag = true;
+
+  var isTop = window === window.top;
+  var counters = {};
+
+  function safe(fn, fallback) { try { return fn(); } catch (e) { return fallback; } }
+  function short(s) { s = String(s == null ? '' : s); return s.length > 140 ? s.slice(0, 140) + '...' : s; }
+  var where = (isTop ? 'top ' : 'frame ') + safe(function () { return location.origin; }, '?');
+  function log(message) { try { console.log('TVBRO-DIAG [' + where + '] ' + message); } catch (e) {} }
+  // at most `max` lines of one kind, so a chatty page does not flood the log
+  function limited(kind, max) { counters[kind] = (counters[kind] || 0) + 1; return counters[kind] <= max; }
+  function active() { return safe(function () { return navigator.userActivation.isActive ? 'yes' : 'no'; }, '?'); }
+  function describe(el) {
+    if (!el || !el.tagName) return String(el);
+    var cls = typeof el.className === 'string' && el.className.trim() ? '.' + el.className.trim().split(/\s+/).slice(0, 2).join('.') : '';
+    return el.tagName.toLowerCase() + (el.id ? '#' + el.id : '') + cls;
+  }
+  function siteOf(host) { var p = String(host).split('.'); return p.length > 2 ? p.slice(-2).join('.') : String(host); }
+
+  // where this frame is: a frame of another site than the page is "third-party" for cookies
+  var topOrigin = safe(function () { var a = location.ancestorOrigins; return a && a.length ? a[a.length - 1] : ''; }, '');
+  var crossSite = !isTop && !!topOrigin &&
+      safe(function () { return siteOf(new URL(topOrigin).hostname) !== siteOf(location.hostname); }, false);
+  log('start url=' + short(location.href) + ' top=' + (isTop ? 'self' : (topOrigin || '?')) + ' crossSite=' + crossSite);
+  var policy = document.permissionsPolicy || document.featurePolicy;
+  if (policy && !isTop) {
+    log('policy autoplay=' + safe(function () { return policy.allowsFeature('autoplay'); }, '?') +
+        ' fullscreen=' + safe(function () { return policy.allowsFeature('fullscreen'); }, '?') +
+        ' encrypted-media=' + safe(function () { return policy.allowsFeature('encrypted-media'); }, '?'));
+  }
+
+  // cookies and storage of a frame of another site (the cookie is written in https frames only: Secure)
+  if (crossSite) {
+    var storage = 'ok';
+    try { localStorage.setItem('tvbro_diag', '1'); localStorage.removeItem('tvbro_diag'); } catch (e) { storage = 'BLOCKED ' + e.name; }
+    log('localStorage in this frame: ' + storage);
+    if (location.protocol === 'https:') {
+      safe(function () { document.cookie = 'tvbro_diag=1; Path=/; Max-Age=60; Secure; SameSite=None'; });
+      log('third-party cookie write: ' + (safe(function () { return document.cookie.indexOf('tvbro_diag=1') >= 0; }, false) ? 'ok' : 'BLOCKED'));
+    }
+  }
+
+  // what the engine can play (once, in the page itself)
+  if (isTop) {
+    safe(function () {
+      var v = document.createElement('video');
+      var mse = window.MediaSource && MediaSource.isTypeSupported ? MediaSource : null;
+      var t = function (type) { return mse ? (mse.isTypeSupported(type) ? 'y' : 'n') : '-'; };
+      log('caps MSE=' + (mse ? 'y' : 'n') + ' avc=' + t('video/mp4; codecs="avc1.640028"') + ' hevc=' + t('video/mp4; codecs="hvc1.1.6.L120.90"') +
+          ' vp9=' + t('video/webm; codecs="vp9"') + ' av1=' + t('video/mp4; codecs="av01.0.08M.08"') + ' aac=' + t('audio/mp4; codecs="mp4a.40.2"') +
+          ' nativeHLS="' + v.canPlayType('application/vnd.apple.mpegurl') + '" cookies=' + navigator.cookieEnabled);
+    });
+  }
+
+  // does the click (a mouse or a finger of the cursor, or a key) reach this frame, and does the frame get a user gesture
+  ['pointerdown', 'mousedown', 'touchstart', 'click', 'keydown'].forEach(function (type) {
+    window.addEventListener(type, function (e) {
+      if (!limited('input', 60)) return;
+      log(type + ' target=' + describe(e.target) + ' trusted=' + e.isTrusted + (e.pointerType ? ' pointer=' + e.pointerType : '') +
+          (type === 'keydown' ? ' key=' + e.key : '') + ' userActive=' + active());
+    }, true);
+  });
+
+  // play(): who called it, with a gesture or not, and why it fails (a player often swallows the rejection)
+  safe(function () {
+    var play = HTMLMediaElement.prototype.play;
+    HTMLMediaElement.prototype.play = function () {
+      var result = play.apply(this, arguments);
+      if (limited('play', 40)) {
+        log('play() on ' + describe(this) + ' userActive=' + active() + ' muted=' + this.muted + ' src=' + short(this.currentSrc || this.src));
+        if (result && typeof result.then === 'function') {
+          result.then(function () { log('play() resolved'); },
+                      function (e) { log('play() REJECTED ' + (e && e.name) + ': ' + short(e && e.message)); });
+        }
+      }
+      return result;
+    };
+  });
+
+  // the windows a page opens (an ad on the first click is the usual one): did the browser give a window
+  safe(function () {
+    var open = window.open;
+    window.open = function () {
+      var result = open.apply(this, arguments);
+      log('window.open(' + short(arguments[0]) + ') -> ' + (result ? 'window' : 'null') + ' userActive=' + active());
+      return result;
+    };
+  });
+
+  // the life of the media element
+  ['loadstart', 'loadedmetadata', 'canplay', 'playing', 'pause', 'waiting', 'stalled', 'error', 'encrypted', 'waitingforkey'].forEach(function (type) {
+    window.addEventListener(type, function (e) {
+      var m = e.target;
+      if (!(m instanceof HTMLMediaElement) || !limited('media-' + type, 12)) return;
+      var extra = type === 'error' && m.error ? ' code=' + m.error.code + ' ' + short(m.error.message) : '';
+      log('media ' + type + ' ' + describe(m) + ' t=' + (m.currentTime || 0).toFixed(1) + ' ready=' + m.readyState +
+          ' net=' + m.networkState + ' src=' + short(m.currentSrc) + extra);
+    }, true);
+  });
+
+  // protected video
+  safe(function () {
+    var request = Navigator.prototype.requestMediaKeySystemAccess;
+    if (!request) { log('EME: requestMediaKeySystemAccess is missing'); return; }
+    Navigator.prototype.requestMediaKeySystemAccess = function (keySystem) {
+      var result = request.apply(this, arguments);
+      result.then(function () { log('EME ' + keySystem + ' granted'); },
+                  function (e) { log('EME ' + keySystem + ' REFUSED ' + short(e && e.message)); });
+      return result;
+    };
+  });
+
+  // fullscreen asked by the player inside the frame
+  safe(function () {
+    var request = Element.prototype.requestFullscreen;
+    if (!request) return;
+    Element.prototype.requestFullscreen = function () {
+      var result = request.apply(this, arguments);
+      log('requestFullscreen on ' + describe(this) + ' userActive=' + active());
+      if (result && typeof result.then === 'function') result.then(null, function (e) { log('requestFullscreen REJECTED ' + short(e && e.message)); });
+      return result;
+    };
+  });
+  ['fullscreenchange', 'webkitfullscreenchange'].forEach(function (type) {
+    document.addEventListener(type, function () {
+      log(type + ' element=' + describe(document.fullscreenElement || document.webkitFullscreenElement));
+    });
+  });
+  document.addEventListener('fullscreenerror', function (e) { log('fullscreenerror ' + describe(e.target)); });
+  document.addEventListener('visibilitychange', function () { log('visibility ' + document.visibilityState); });
+
+  // what breaks: scripts and files that fail to load (a blocked ad script answers 403), errors, refused promises
+  window.addEventListener('error', function (e) {
+    if (!limited('error', 40)) return;
+    var t = e.target;
+    if (t && t !== window && t.tagName) log('load error ' + t.tagName.toLowerCase() + ' ' + short(t.currentSrc || t.src || t.href));
+    else log('script error: ' + short(e.message) + ' at ' + short(e.filename) + ':' + e.lineno);
+  }, true);
+  window.addEventListener('unhandledrejection', function (e) {
+    if (!limited('rejection', 20)) return;
+    var r = e.reason;
+    log('unhandled rejection: ' + short(r && r.name ? r.name + ': ' + r.message : r));
+  });
+  document.addEventListener('securitypolicyviolation', function (e) {
+    if (limited('csp', 10)) log('CSP ' + e.violatedDirective + ' blocked ' + short(e.blockedURI));
+  });
+})();
