index 0000000..04643d9
--- /dev/null
+++ b/app/src/main/java/com/phlox/tvwebbrowser/webengine/webview/WebViewPlayerCompat.kt
@@ -0,0 +1,24 @@
+package com.phlox.tvwebbrowser.webengine.webview
+
+import android.webkit.CookieManager
+import android.webkit.WebSettings
+import android.webkit.WebView
+
+/**
+ * What players embedded in a page from another site (an iframe) get in Chrome and an app's WebView has switched
+ * off: for an app that targets Lollipop or later both defaults below are the strict ones.
+ *
+ * - Cookies of a frame from another site than the page. The player asks its own server for the stream with the
+ *   session and the tokens it keeps in them, so without them it starts nothing and often says nothing.
+ *   [CookieManager.setAcceptThirdPartyCookies] is a setting of each WebView, so every view (tabs, windows the
+ *   pages open, restored tabs) has to pass through here.
+ * - Passive mixed content (a poster or a media file over http on a page over https). Chrome upgrades it to https
+ *   or loads it; WebView with MIXED_CONTENT_NEVER_ALLOW refuses all of it. The compatibility mode is the
+ *   WebView's own way to follow the browser: the rest (scripts, frames, requests of the page) stays blocked.
+ */
+internal object WebViewPlayerCompat {
+    fun apply(webView: WebView) {
+        CookieManager.getInstance().setAcceptThirdPartyCookies(webView, true)
+        webView.settings.mixedContentMode = WebSettings.MIXED_CONTENT_COMPATIBILITY_MODE
+    }
+}
